diff --git a/include/plugins/search-plus/searchplus.php b/include/plugins/search-plus/searchplus.php
new file mode 100644
index 0000000..d55a185
--- /dev/null
+++ b/include/plugins/search-plus/searchplus.php
@@ -0,0 +1,179 @@
+<?php
+/*********************************************************************
+ * Search Plus plugin for osTicket 1.17 / 1.18
+ *
+ * Ticket keyword search (staff search box, Advanced Search "Keywords",
+ * client portal) and the staff Tasks search box are replaced with:
+ *
+ *   printer jam      every word must match, in any order, anywhere in the
+ *                    ticket (subject, any thread entry, custom fields,
+ *                    requester name/email)
+ *   ab               no minimum word length
+ *   rint             words match inside other words ("printer")
+ *   PN*100           * matches any run of characters, ? a single one
+ *   "fuser unit"     exact phrase
+ *   -closed          exclude tickets containing the word
+ *
+ * Matching is case- and accent-insensitive. It uses the existing
+ * %TABLE_PREFIX%_search index table (kept up to date by osTicket), so no
+ * schema change is needed. User / organization lookups are unchanged.
+ *********************************************************************/
+
+require_once INCLUDE_DIR . 'class.plugin.php';
+require_once INCLUDE_DIR . 'class.signal.php';
+require_once __DIR__ . '/config.php';
+
+class SearchPlusPlugin extends Plugin {
+    var $config_class = 'SearchPlusConfig';
+
+    static $opts = null;
+
+    function isMultiInstance() {
+        return false;
+    }
+
+    function bootstrap() {
+        $c = $this->getConfig();
+        self::$opts = array(
+            'tickets' => (bool) $c->get('tickets', true),
+            'tasks' => (bool) $c->get('tasks', true),
+            'cross' => (bool) $c->get('cross', true),
+            'max_terms' => max(1, min(20, (int) ($c->get('max_terms') ?: 8))),
+        );
+
+        if (self::$opts['tickets']) {
+            // Replace the stock MySQL backend (same id). Plugins bootstrap
+            // before osTicket creates its search interface.
+            require_once INCLUDE_DIR . 'class.search.php';
+            require_once __DIR__ . '/backend.php';
+            SearchPlusBackend::register();
+        }
+        if (self::$opts['tasks'])
+            Signal::connect('tasks.search', array(__CLASS__, 'onTaskSearch'));
+    }
+
+    /* ---------------------------------------------------------------
+     * Query parsing
+     * ------------------------------------------------------------- */
+
+    /**
+     * Returns array(positive LIKE patterns, negative LIKE patterns).
+     */
+    static function parse($query) {
+        $max = self::$opts ? self::$opts['max_terms'] : 8;
+        $pos = $neg = array();
+        preg_match_all('/(-?)"([^"]*)"?|(\S+)/u', (string) $query, $M, PREG_SET_ORDER);
+        foreach ($M as $m) {
+            $not = false;
+            if (isset($m[3]) && $m[3] !== '') {
+                $t = $m[3];
+                if ($t[0] === '-' && strlen($t) > 1) { $not = true; $t = substr($t, 1); }
+                $t = ltrim($t, '+');
+                $t = str_replace('"', '', $t);
+            } else {
+                $not = $m[1] === '-';
+                $t = $m[2];
+            }
+            $t = trim(preg_replace('/\s+/u', ' ', $t));
+            if ($t === '' || trim($t, '*?') === '')
+                continue;
+            $like = self::toLike($t);
+            if ($not)
+                $neg[] = $like;
+            elseif (count($pos) < $max)
+                $pos[] = $like;
+        }
+        return array(array_values(array_unique($pos)),
+            array_values(array_unique($neg)));
+    }
+
+    /** "PN*100" -> "%PN%100%" with LIKE metacharacters escaped. */
+    static function toLike($term) {
+        $t = addcslashes($term, '\\%_');
+        $t = strtr($t, array('*' => '%', '?' => '_'));
+        $t = preg_replace('/%+/', '%', "%{$t}%");
+        // ':' followed by digits can be read as a parameter marker by the
+        // ORM; '_' (any single character) still matches "10:30" etc.
+        return str_replace(':', '_', $t);
+    }
+
+    /**
+     * Build WHERE / HAVING / relevance SQL for a derived table with a
+     * text column `txt`, grouped by the object id.
+     */
+    static function sqlParts($pos, $neg, $col='M.txt') {
+        $any = $have = $rel = array();
+        foreach ($pos as $p) {
+            $l = sprintf('%s LIKE %s', $col, db_input($p));
+            $any[] = $l;
+            $have[] = "SUM($l) > 0";
+            $rel[] = "SUM($l)";
+        }
+        foreach ($neg as $n) {
+            $l = sprintf('%s LIKE %s', $col, db_input($n));
+            $any[] = $l;
+            $have[] = "SUM($l) = 0";
+        }
+        return array(
+            '(' . implode(' OR ', $any) . ')',
+            implode(' AND ', $have),
+            '(' . implode(' + ', $rel) . ')',
+        );
+    }
+
+    /* ---------------------------------------------------------------
+     * Tasks
+     * ------------------------------------------------------------- */
+
+    /**
+     * Signal sent from include/staff/tasks.inc.php (see patch). Filters
+     * the task QuerySet in place and marks the search as handled.
+     */
+    static function onTaskSearch($tasks, &$data) {
+        list($pos, $neg) = self::parse(@$data['query']);
+        if (!$pos)
+            return;     // nothing usable: fall back to stock behaviour
+
+        list($where, $having) = self::sqlParts($pos, $neg);
+        $P = TABLE_PREFIX;
+        $cross = !empty(self::$opts['cross']);
+
+        // Which threads count for which task: the task's own thread, and
+        // (cross-search) the parent ticket's thread for each of its tasks.
+        $threadMap = "SELECT TH.id AS thread_id, TH.object_id AS task_id
+              FROM `{$P}thread` TH WHERE TH.object_type = 'A'";
+        if ($cross)
+            $threadMap .= "
+            UNION ALL
+              SELECT TH.id, TK.id FROM `{$P}thread` TH
+              JOIN `{$P}task` TK ON (TK.object_type = 'T' AND TK.object_id = TH.object_id)
+              WHERE TH.object_type = 'T'";
+
+        $sql = "(SELECT M.task_id FROM (
+              SELECT T.id AS task_id, T.number AS txt FROM `{$P}task` T
+            UNION ALL
+              SELECT FE.object_id, FV.value
+              FROM `{$P}form_entry` FE
+              JOIN `{$P}form_entry_values` FV ON (FV.entry_id = FE.id)
+              WHERE FE.object_type = 'A'
+            UNION ALL
+              SELECT MP.task_id, CONCAT_WS(' ', S.title, S.content)
+              FROM `{$P}_search` S
+              JOIN `{$P}thread_entry` E ON (S.object_type = 'H' AND S.object_id = E.id)
+              JOIN ({$threadMap}) MP ON (MP.thread_id = E.thread_id)"
+            . ($cross ? "
+            UNION ALL
+              SELECT TK.id, CONCAT_WS(' ', S.title, S.content)
+              FROM `{$P}_search` S
+              JOIN `{$P}task` TK ON (TK.object_type = 'T' AND TK.object_id = S.object_id)
+              WHERE S.object_type = 'T'" : "") . "
+            ) M
+            WHERE {$where}
+            GROUP BY M.task_id
+            HAVING {$having}) ZSP";
+
+        $tasks->extra(array('tables' => array($sql)));
+        $tasks->filter(array('id' => new SqlCode('ZSP.`task_id`')));
+        $data['handled'] = true;
+    }
+}
