diff --git a/include/plugins/task-status/taskstatus.php b/include/plugins/task-status/taskstatus.php
new file mode 100644
index 0000000..acd3176
--- /dev/null
+++ b/include/plugins/task-status/taskstatus.php
@@ -0,0 +1,268 @@
+<?php
+/*********************************************************************
+ * Task Statuses plugin for osTicket 1.17 / 1.18
+ *
+ * osTicket tasks are only open or closed (shown as "Open" / "Completed").
+ * This plugin adds named statuses on top of that, each mapped to the open
+ * or closed state:
+ *
+ *  - The Status drop-down on task Post Update / Post Internal Note lists
+ *    the configured statuses instead of Open / Closed.
+ *  - The task header, preview, print view, the ticket's Tasks tab and the
+ *    Tasks list "Status" column show the named status.
+ *  - Closing / reopening a task any other way (Close button, bulk action,
+ *    closing the parent ticket) sets the default closed / open status.
+ *
+ * Statuses are stored in %TABLE_PREFIX%task_status (created on first use).
+ *********************************************************************/
+
+require_once INCLUDE_DIR . 'class.plugin.php';
+require_once INCLUDE_DIR . 'class.signal.php';
+require_once __DIR__ . '/config.php';
+
+class TaskStatusPlugin extends Plugin {
+    var $config_class = 'TaskStatusConfig';
+
+    static $list = null;        // name => 'open' | 'closed'
+    static $default = array();  // state => default name
+    static $cache = array();    // task_id => stored name|false
+    static $pending = array();  // task_id => name chosen in this request
+    static $schemaOk = false;
+
+    function isMultiInstance() {
+        return false;
+    }
+
+    function bootstrap() {
+        $list = self::parseList($this->getConfig()->get('statuses'));
+        foreach ($list as $name => $state)
+            if (!isset(self::$default[$state]))
+                self::$default[$state] = $name;
+        if (!isset(self::$default['open']) || !isset(self::$default['closed']))
+            return;     // misconfigured: leave stock behaviour alone
+        self::$list = $list;
+
+        Signal::connect('task.status.name', array(__CLASS__, 'onStatusName'));
+        Signal::connect('object.view', array(__CLASS__, 'onTaskView'), 'Task');
+        Signal::connect('threadentry.created', array(__CLASS__, 'onEntryCreated'));
+        Signal::connect('model.updated', array(__CLASS__, 'onTaskUpdated'), 'Task');
+        Signal::connect('model.deleted', array(__CLASS__, 'onTaskDeleted'), 'Task');
+        Signal::connect('ajax.scp', function($dispatcher) {
+            $dispatcher->append(url_post('^/taskstatus/(?P<id>\d+)$',
+                function($id) { TaskStatusPlugin::ajaxSetStatus($id); }));
+        });
+    }
+
+    /** "Name | open" lines -> array(name => state) */
+    static function parseList($text) {
+        $list = array();
+        foreach (preg_split('/\R/u', (string) $text) as $line) {
+            $parts = array_map('trim', explode('|', $line, 2));
+            if ($parts[0] === '')
+                continue;
+            $state = strtolower(@$parts[1] ?: 'open');
+            if (!in_array($state, array('open', 'closed')))
+                $state = 'open';
+            $name = mb_substr($parts[0], 0, 64);
+            if (!isset($list[$name]))
+                $list[$name] = $state;
+        }
+        return $list;
+    }
+
+    /* ---------------------------------------------------------------
+     * Storage
+     * ------------------------------------------------------------- */
+
+    static function table() {
+        return TABLE_PREFIX . 'task_status';
+    }
+
+    static function ensureSchema() {
+        if (self::$schemaOk)
+            return true;
+        return self::$schemaOk = (bool) db_query('CREATE TABLE IF NOT EXISTS `'
+            . self::table() . '` (
+              `task_id` int(11) unsigned NOT NULL,
+              `status` varchar(64) NOT NULL,
+              `updated` datetime NOT NULL,
+              PRIMARY KEY (`task_id`)
+            ) DEFAULT CHARSET=utf8');
+    }
+
+    static function getStored($taskId) {
+        $taskId = (int) $taskId;
+        if (!array_key_exists($taskId, self::$cache)) {
+            self::$cache[$taskId] = false;
+            if (self::ensureSchema()
+                && ($res = db_query(sprintf('SELECT status FROM `%s` WHERE task_id=%d',
+                    self::table(), $taskId)))
+                && ($row = db_fetch_array($res)))
+                self::$cache[$taskId] = $row['status'];
+        }
+        return self::$cache[$taskId];
+    }
+
+    static function setStored($taskId, $name) {
+        if (!self::ensureSchema())
+            return false;
+        self::$cache[(int) $taskId] = $name;
+        return db_query(sprintf(
+            'INSERT INTO `%s` (task_id, status, updated) VALUES (%d, %s, NOW())
+             ON DUPLICATE KEY UPDATE status=VALUES(status), updated=NOW()',
+            self::table(), $taskId, db_input($name)));
+    }
+
+    /** Effective status name for a task id in a given state. */
+    static function nameFor($taskId, $isOpen) {
+        $state = $isOpen ? 'open' : 'closed';
+        $name = self::getStored($taskId);
+        if ($name !== false && @self::$list[$name] === $state)
+            return $name;
+        return self::$default[$state];
+    }
+
+    /* ---------------------------------------------------------------
+     * Signal handlers
+     * ------------------------------------------------------------- */
+
+    static function onStatusName($obj, &$data) {
+        if (self::$list && !empty($data['id']))
+            $data['status'] = self::nameFor($data['id'], !empty($data['isopen']));
+    }
+
+    /** Status chosen on Post Update / Post Internal Note. */
+    static function onEntryCreated($entry) {
+        global $thisstaff;
+        if (!self::$list || !$thisstaff || $_SERVER['REQUEST_METHOD'] !== 'POST'
+                || !in_array(@$_POST['a'], array('postreply', 'postnote')))
+            return;
+        $name = trim((string) @$_POST['ts_status']);
+        if ($name === '' || !isset(self::$list[$name]))
+            return;
+        if (!($thread = $entry->getThread()) || $thread->getObjectType() !== 'A'
+                || !($task = $thread->getObject()))
+            return;
+
+        // osTicket changes open/closed right after saving the entry. If the
+        // chosen status keeps the current state, save it now; otherwise
+        // wait for the state change (it may be refused, e.g. not closeable).
+        $wantOpen = self::$list[$name] === 'open';
+        if ($wantOpen === (bool) $task->isOpen())
+            self::setStored($task->getId(), $name);
+        else
+            self::$pending[$task->getId()] = $name;
+    }
+
+    /** Task opened/closed (any route): pick the matching status. */
+    static function onTaskUpdated($task, &$data) {
+        if (!self::$list || !isset($data['dirty']) || !array_key_exists('flags', $data['dirty']))
+            return;
+        $wasOpen = (bool) ((int) $data['dirty']['flags'] & TaskModel::ISOPEN);
+        $isOpen = (bool) $task->isOpen();
+        if ($wasOpen === $isOpen)
+            return;
+        $id = $task->getId();
+        $state = $isOpen ? 'open' : 'closed';
+        $name = @self::$pending[$id];
+        unset(self::$pending[$id]);
+        if (!$name || self::$list[$name] !== $state)
+            $name = self::$default[$state];
+        self::setStored($id, $name);
+    }
+
+    static function onTaskDeleted($task, &$data=null) {
+        if (self::ensureSchema())
+            db_query(sprintf('DELETE FROM `%s` WHERE task_id=%d',
+                self::table(), $task->getId()));
+    }
+
+    /**
+     * Change a task to a named status (from the task's Change Status menu).
+     * Opens/closes the task when the status's state differs, and adds an
+     * internal note recording the change.
+     */
+    static function changeStatus($task, $name, &$error) {
+        global $thisstaff;
+        if (!isset(self::$list[$name])) {
+            $error = __('Unknown status');
+            return false;
+        }
+        $id = $task->getId();
+        $current = self::nameFor($id, $task->isOpen());
+        if ($name === $current)
+            return true;
+
+        $state = self::$list[$name];
+        if ($state === 'closed' && $task->isOpen()) {
+            if (!$task->checkStaffPerm($thisstaff, Task::PERM_CLOSE)) {
+                $error = __('You do not have permission to close this task');
+                return false;
+            }
+            $errors = array();
+            self::$pending[$id] = $name;
+            if (!$task->setStatus('closed', '', $errors) || $task->isOpen()) {
+                unset(self::$pending[$id]);
+                $error = $errors['err'] ?: __('This task cannot be closed');
+                return false;
+            }
+        } elseif ($state === 'open' && !$task->isOpen()) {
+            $errors = array();
+            self::$pending[$id] = $name;
+            if (!$task->setStatus('open', '', $errors) || !$task->isOpen()) {
+                unset(self::$pending[$id]);
+                $error = $errors['err'] ?: __('This task cannot be reopened');
+                return false;
+            }
+        } else {
+            self::setStored($id, $name);
+        }
+        // Make sure the chosen name stuck (state-change handler uses pending)
+        if (self::getStored($id) !== $name)
+            self::setStored($id, $name);
+
+        $errors = array();
+        $task->postNote(array(
+            'title' => __('Status changed'),
+            'note' => sprintf(__('Status changed from <b>%s</b> to <b>%s</b>.'),
+                Format::htmlchars($current), Format::htmlchars($name)),
+        ), $errors, $thisstaff, false);
+        return true;
+    }
+
+    static function ajaxSetStatus($id) {
+        global $thisstaff;
+        if (!$thisstaff)
+            Http::response(403, 'Login required');
+        if (!($task = Task::lookup((int) $id)) || !$task->checkStaffPerm($thisstaff))
+            Http::response(404, 'No such task');
+        $error = '';
+        if (!self::changeStatus($task, trim((string) @$_POST['status']), $error))
+            Http::response(422, Format::htmlchars($error));
+        Http::response(200, JsonDataEncoder::encode(array('ok' => true,
+            'status' => self::nameFor($task->getId(), $task->isOpen()))),
+            'application/json');
+    }
+
+    /** Swap the Open/Closed drop-downs for the named statuses. */
+    static function onTaskView($task, &$data=null) {
+        global $thisstaff;
+        if (!self::$list || !$thisstaff || !defined('OSTSCPINC'))
+            return;
+
+        $current = self::nameFor($task->getId(), $task->isOpen());
+        // Re-select the posted choice if the form is redisplayed with errors
+        if (isset($_POST['ts_status'], $_POST['id']) && (int) $_POST['id'] === (int) $task->getId()
+                && isset(self::$list[$_POST['ts_status']]) && !empty($GLOBALS['errors']))
+            $current = $_POST['ts_status'];
+
+        $statuses = array();
+        foreach (self::$list as $name => $state)
+            $statuses[] = array('name' => $name, 'state' => $state);
+        $json = json_encode(array('statuses' => $statuses, 'current' => $current,
+                'id' => (int) $task->getId(), 'open' => (bool) $task->isOpen(),
+                'saved' => self::nameFor($task->getId(), $task->isOpen())),
+            JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
+        include __DIR__ . '/view.inc.php';
+    }
+}
diff --git a/include/plugins/task-status/view.inc.php b/include/plugins/task-status/view.inc.php
new file mode 100644
index 0000000..ef5a7bf
--- /dev/null
+++ b/include/plugins/task-status/view.inc.php
@@ -0,0 +1,103 @@
+<?php
+// Rendered at the top of the staff task view (object.view signal).
+// Expects $json from TaskStatusPlugin::onTaskView().
+if (!defined('OSTSCPINC')) die('Access Denied');
+?>
+<script type="text/javascript">
+(function($) {
+  var cfg = <?php echo $json; ?>;
+
+  function upgrade(formSel) {
+    var $orig = $(formSel).find('select[name="task:status"]').first();
+    if (!$orig.length || $orig.data('ts-done')) return;
+    $orig.data('ts-done', 1);
+
+    // States the agent may pick here (osTicket omits "closed" when the
+    // task can't be closed or the agent lacks permission)
+    var allowed = {};
+    $orig.find('option').each(function() { allowed[this.value] = true; });
+
+    var $sel = $('<select name="ts_status"></select>');
+    $.each(cfg.statuses, function(i, s) {
+      if (!allowed[s.state]) return;
+      $('<option/>').val(s.name).text(s.name).attr('data-state', s.state)
+        .prop('selected', s.name === cfg.current)
+        .appendTo($sel);
+    });
+    if (!$sel.find('option:selected').length)
+      $sel.find('option[data-state="' + $orig.val() + '"]').first().prop('selected', true);
+
+    function sync() {
+      $orig.val($sel.find('option:selected').attr('data-state') || $orig.val());
+    }
+    $sel.on('change', sync);
+    $orig.hide().after($sel);
+    sync();
+  }
+
+  // Task "Change Status" menu (standalone task) and the "Actions" menu
+  // (task opened inside a ticket): list the named statuses
+  function statusItems(canClose) {
+    var html = '';
+    $.each(cfg.statuses, function(i, s) {
+      if (s.name === cfg.saved) return;
+      if (s.state === 'closed' && cfg.open && !canClose) return;
+      var label = $('<div/>').text(s.name).html();
+      html += '<li><a class="no-pjax ts-set" href="#" data-name="' + label.replace(/"/g, '&quot;') +
+        '"><i class="icon-fixed-width ' + (s.state === 'closed' ? 'icon-ok-circle' : 'icon-flag') +
+        '"></i> ' + label + '</a></li>';
+    });
+    return html;
+  }
+
+  function upgradeMenu(sel, replaceAll) {
+    var $ul = $(sel).first();
+    if (!$ul.length || $ul.data('ts-done')) return;
+    $ul.data('ts-done', 1);
+    var $stock = $ul.find('a[href$="/close"], a[href$="/reopen"]').closest('li');
+    // osTicket only offers "Close" to agents who may close this task
+    var canClose = !cfg.open || $ul.find('a[href$="/close"]').length > 0;
+    var items = statusItems(canClose);
+    if (replaceAll) $ul.html(items);
+    else if ($stock.length) { $stock.first().before(items); $stock.remove(); }
+    else $ul.prepend(items);
+    $ul.off('click.ts').on('click.ts', 'a.ts-set', function(e) {
+      e.preventDefault();
+      e.stopImmediatePropagation();
+      var name = $(this).attr('data-name');
+      $.ajax({url: 'ajax.php/taskstatus/' + cfg.id, type: 'POST', data: {status: name}})
+        .done(function() {
+          var $reload = $('a#reload-task[href^="#tickets/"]');
+          if ($reload.length) $reload.trigger('click');   // task inside a ticket
+          else window.location.reload();
+        })
+        .fail(function(xhr) {
+          $.sysAlert('Change Status', xhr.responseText || 'Unable to change the status');
+        });
+      return false;
+    });
+  }
+
+  function init() {
+    upgrade('#task_reply');
+    upgrade('#task_note');
+    upgradeMenu('#action-dropdown-tasks-status ul', true);
+    upgradeMenu('#action-dropdown-task-options ul', false);
+    // The status value in the task header is a Close/Reopen shortcut: make it
+    // open the status menu instead
+    $('th').filter(function() { return $.trim($(this).text()) === 'Status:'; })
+      .next('td').find('a.task-action[href$="/close"], a.task-action[href$="/reopen"]')
+      .removeClass('task-action').addClass('no-pjax').attr('href', '#')
+      .off('click.ts').on('click.ts', function(e) {
+        e.preventDefault();
+        e.stopImmediatePropagation();
+        var $btn = $('[data-dropdown="#action-dropdown-tasks-status"]').first();
+        if ($btn.length) $btn.trigger('click');
+        return false;
+      });
+  }
+
+  // Normal page load, PJAX navigation and tasks loaded by AJAX in a ticket
+  $(function() { setTimeout(init, 0); });
+})(jQuery);
+</script>
