diff --git a/include/plugins/search-plus/backend.php b/include/plugins/search-plus/backend.php
new file mode 100644
index 0000000..518d1ab
--- /dev/null
+++ b/include/plugins/search-plus/backend.php
@@ -0,0 +1,77 @@
+<?php
+/*
+ * Drop-in replacement for osTicket's MysqlSearchBackend. Indexing is
+ * inherited unchanged; only ticket keyword matching (find) differs.
+ */
+class SearchPlusBackend extends MysqlSearchBackend {
+    static $id = 'mysql';   // same id: replaces the stock backend
+
+    function find($query, QuerySet $criteria, $addRelevance=true, $options=array()) {
+        if ($criteria->model && $criteria->model !== 'Ticket')
+            return parent::find($query, $criteria, $addRelevance, $options);
+
+        list($pos, $neg) = SearchPlusPlugin::parse($query);
+        if (!$pos)
+            return $criteria;
+
+        $criteria = clone $criteria;
+        list($where, $having, $rel) = SearchPlusPlugin::sqlParts($pos, $neg);
+        $P = TABLE_PREFIX;
+        // Cross-search (staff only): words in a ticket's tasks also count.
+        // Not for the client portal, since tasks are internal.
+        global $thisstaff;
+        $cross = $thisstaff && !empty(SearchPlusPlugin::$opts['cross']);
+
+        // One row per indexed item, mapped to the ticket it belongs to:
+        //   T = ticket (number, subject, custom fields)
+        //   H = thread entry of a ticket
+        //   U = requester (name, email, contact fields) -> all their tickets
+        //   (cross-search) H in a task's thread -> the task's ticket, and
+        //   the task's form fields (title, ...) -> the task's ticket
+        $threadTypes = $cross ? "'T', 'C', 'A'" : "'T', 'C'";
+        $threadTicket = $cross
+            ? "IF(Z3.`object_type` = 'A', ZK.`object_id`, Z3.`object_id`)"
+            : "Z3.`object_id`";
+        $taskJoin = $cross ? "
+              LEFT JOIN `{$P}task` ZK
+                     ON (Z3.`object_type` = 'A' AND ZK.`id` = Z3.`object_id`
+                         AND ZK.`object_type` = 'T')" : "";
+        $taskFields = $cross ? "
+            UNION ALL
+              SELECT TK.`object_id`, FV.`value`
+              FROM `{$P}form_entry` FE
+              JOIN `{$P}form_entry_values` FV ON (FV.`entry_id` = FE.`id`)
+              JOIN `{$P}task` TK ON (TK.`id` = FE.`object_id` AND TK.`object_type` = 'T')
+              WHERE FE.`object_type` = 'A'" : "";
+        $sql = "(SELECT M.ticket_id, {$rel} AS relevance FROM (
+              SELECT COALESCE({$threadTicket}, Z5.`ticket_id`, Z8.`ticket_id`) AS ticket_id,
+                     CONCAT_WS(' ', S.`title`, S.`content`) AS txt
+              FROM `{$P}_search` S
+              LEFT JOIN `{$P}thread_entry` Z2
+                     ON (S.`object_type` = 'H' AND S.`object_id` = Z2.`id`)
+              LEFT JOIN `{$P}thread` Z3
+                     ON (Z2.`thread_id` = Z3.`id` AND Z3.`object_type` IN ({$threadTypes})){$taskJoin}
+              LEFT JOIN `{$P}ticket` Z5
+                     ON (S.`object_type` = 'T' AND S.`object_id` = Z5.`ticket_id`)
+              LEFT JOIN `{$P}user` Z6
+                     ON (S.`object_type` = 'U' AND S.`object_id` = Z6.`id`)
+              LEFT JOIN `{$P}ticket` Z8
+                     ON (Z8.`user_id` = Z6.`id`)
+              WHERE S.`object_type` IN ('T', 'H', 'U'){$taskFields}
+            ) M
+            WHERE M.ticket_id IS NOT NULL AND {$where}
+            GROUP BY M.ticket_id
+            HAVING {$having}) Z1";
+
+        if ($addRelevance) {
+            $criteria = $criteria->extra(array(
+                'select' => array('__relevance__' => 'Z1.`relevance`'),
+            ));
+        }
+        $criteria->extra(array('tables' => array($sql)));
+        $criteria->extra(array('order_by' => array(
+            array(new SqlCode('Z1.relevance', 'DESC')))));
+        $criteria->filter(array('ticket_id' => new SqlCode('Z1.`ticket_id`')));
+        return $criteria;
+    }
+}
