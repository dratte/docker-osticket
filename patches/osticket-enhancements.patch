+        echo $h($name . ($id === (int) $thisstaff->getId() ? ' (me)' : '')); ?></option>
+      <?php } ?>
+    </select></label>
+  <?php } ?>
+  <label><strong>Period:</strong>
+    <select name="period" id="ttm-period">
+      <?php foreach ($periods as $k => $v) { ?>
+      <option value="<?php echo $k; ?>" <?php if ($k === $period) echo 'selected="selected"'; ?>><?php echo $h($v); ?></option>
+      <?php } ?>
+    </select></label>
+  <span id="ttm-custom" style="<?php if ($period !== 'custom') echo 'display:none'; ?>">
+    <label>From <input type="date" name="from" value="<?php echo $h(@$_GET['from']); ?>"></label>
+    <label>To <input type="date" name="to" value="<?php echo $h(@$_GET['to']); ?>"></label>
+  </span>
+  <input type="hidden" name="view" value="<?php echo $h($view); ?>">
+  <input type="submit" value="Run report">
+  <div class="faded" style="margin-top:4px"><?php echo $h($agentName); ?> &mdash; <?php echo $h($label); ?>
+    &mdash; by the date each entry was logged</div>
+</form>
+
+<div class="ttm-print-head"><h3><?php echo $h($agentName); ?> &mdash; <?php echo $h($label); ?></h3></div>
+
+<div class="ttm-totals">
+  <span>Total time <b><?php echo $hrs($total['minutes']); ?> h</b></span>
+  <span>Total cost <b><?php echo $h($money($total['cost'])); ?></b></span>
+  <span>Entries <b><?php echo (int) $total['entries']; ?></b></span>
+  <span>Tickets / tasks <b><?php echo (int) $total['items']; ?></b></span>
+</div>
+
+<div class="ttm-views">
+  <a href="<?php echo $h($qs(array('view' => 'entries'))); ?>" class="<?php if ($view === 'entries') echo 'active'; ?>"><i class="icon-list"></i> Entries</a>
+  <a href="<?php echo $h($qs(array('view' => 'timesheet'))); ?>" class="<?php if ($view === 'timesheet') echo 'active'; ?>"><i class="icon-table"></i> Timesheet</a>
+</div>
+
+<?php if (!$rows) { ?>
+  <p class="faded">No time logged by <?php echo $h($agentName); ?> in this period.</p>
+<?php } elseif ($view === 'timesheet') { ?>
+  <div class="ttm-grid-wrap">
+  <table class="ttm ttm-grid">
+    <thead><tr>
+      <th>Ticket / Task</th>
+      <?php foreach ($buckets as $b) { ?>
+      <th class="cell<?php if ($b[2]) echo ' we'; ?>"><?php echo $h($b[0]); ?></th>
+      <?php } ?>
+      <th class="cell tot">Hours</th><th class="cell">Cost</th>
+    </tr></thead>
+    <tbody>
+    <?php foreach ($grid as $g) { ?>
+      <tr class="<?php echo $g['task'] ? 'ttm-task' : ''; ?>">
+        <td class="item"><?php echo $h(AgentTimeReport::gridLabel($g)); ?>
+          <?php if ($g['category']) { ?><span class="faded"> &middot; <?php echo $h($g['category']); ?></span><?php } ?></td>
+        <?php foreach ($buckets as $k => $b) { ?>
+        <td class="cell<?php if ($b[2]) echo ' we'; ?>"><?php echo $hrs(@$g['cells'][$k], true); ?></td>
+        <?php } ?>
+        <td class="cell tot"><?php echo $hrs($g['minutes']); ?></td>
+        <td class="cell"><?php echo $h($money($g['cost'])); ?></td>
+      </tr>
+    <?php } ?>
+      <tr class="ttm-total">
+        <td>Total</td>
+        <?php foreach ($buckets as $k => $b) { ?>
+        <td class="cell<?php if ($b[2]) echo ' we'; ?>"><?php echo $hrs($summary[$k]['minutes'], true); ?></td>
+        <?php } ?>
+        <td class="cell tot"><?php echo $hrs($total['minutes']); ?></td>
+        <td class="cell"><?php echo $h($money($total['cost'])); ?></td>
+      </tr>
+    </tbody>
+  </table>
+  </div>
+  <p class="faded ttm-noprint">Hours per <?php echo strtolower($unitName[$unit]); ?>.
+    <?php if ($unit !== 'day') echo 'Choose a period of up to 31 days to see individual days.'; ?></p>
+<?php } else { ?>
+  <h3>By <?php echo strtolower($unitName[$unit]); ?></h3>
+  <table class="ttm" style="width:auto;min-width:420px">
+    <thead><tr><th><?php echo $unitName[$unit]; ?></th><th class="num">Entries</th><th class="num">Hours</th><th class="num">Cost</th></tr></thead>
+    <tbody>
+    <?php foreach ($buckets as $k => $b) { $s = $summary[$k]; ?>
+      <tr class="<?php if (!$s['entries']) echo 'ttm-empty'; ?>">
+        <td><?php echo $h($unit === 'day' ? $b[1]->format('D, M j') : ($unit === 'week'
+            ? 'Week of ' . $b[1]->format('M j') : $b[0])); ?></td>
+        <td class="num"><?php echo $s['entries'] ?: ''; ?></td>
+        <td class="num"><?php echo $hrs($s['minutes'], true); ?></td>
+        <td class="num"><?php echo $s['entries'] ? $h($money($s['cost'])) : ''; ?></td>
+      </tr>
+    <?php } ?>
+      <tr class="ttm-total"><td>Total</td><td class="num"><?php echo (int) $total['entries']; ?></td>
+        <td class="num"><?php echo $hrs($total['minutes']); ?></td><td class="num"><?php echo $h($money($total['cost'])); ?></td></tr>
+    </tbody>
+  </table>
+
+  <h3>Entries</h3>
+  <table class="ttm">
+    <thead><tr><th>Date</th><th>Ticket</th><th>Task</th><th>Subject / title</th><th>Category</th><th>Note</th>
+      <th class="num">Hours</th><th class="num">Cost</th></tr></thead>
+    <tbody>
+    <?php foreach ($rows as $r) { ?>
+      <tr>
+        <td style="white-space:nowrap"><?php echo $h($r['when']->format('D M j, g:i A')); ?></td>
+        <td style="white-space:nowrap"><?php echo $ticketLink($r); ?></td>
+        <td style="white-space:nowrap"><?php echo $taskLink($r); ?></td>
+        <td><?php echo $h($r['title']); ?></td>
+        <td><?php echo $h($r['category']); ?></td>
+        <td class="ttm-note"><?php echo $h($r['note']); ?></td>
+        <td class="num"><?php echo $hrs($r['minutes']); ?></td>
+        <td class="num"><?php echo $h($money($r['cost'])); ?></td>
+      </tr>
+    <?php } ?>
+      <tr class="ttm-total"><td colspan="6">Total</td>
+        <td class="num"><?php echo $hrs($total['minutes']); ?></td><td class="num"><?php echo $h($money($total['cost'])); ?></td></tr>
+    </tbody>
+  </table>
+<?php } ?>
+</div>
+
+<script type="text/javascript">
+(function($) {
+  $('#ttm-period').on('change', function() { $('#ttm-custom').toggle(this.value === 'custom'); });
+})(jQuery);
+</script>
