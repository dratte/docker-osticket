+    return ($v < 0 ? '-' : '') . $cur . number_format(abs($v), 2);
+};
+$hrs = function($m, $blank=false) { return ($blank && !$m) ? '' : number_format($m / 60, 2); };
+$qs = function($extra) {
+    $q = array_merge($_GET, $extra);
+    foreach ($q as $k => $v) if ($v === null) unset($q[$k]);
+    return 'mytime.php?' . Http::build_query($q);
+};
+$unitName = array('day' => 'Day', 'week' => 'Week', 'month' => 'Month');
+$ticketLink = function($r) use ($h) {
+    if ((int) $r['ticket_id'] && $r['tnum'])
+        return sprintf('<a href="tickets.php?id=%d">%s</a>', $r['ticket_id'], $h($r['ticket']));
+    return $h($r['ticket']);
+};
+$taskLink = function($r) use ($h) {
+    if ($r['object_type'] === 'A' && $r['knum'])
+        return sprintf('<a href="tasks.php?id=%d">%s</a>', $r['object_id'], $h($r['task']));
+    return $h($r['task']);
+};
+?>
+<style type="text/css">
+  #ttm h2 { margin: 6px 0 12px; }
