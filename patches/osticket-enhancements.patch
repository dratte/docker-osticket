+  #ttm tr.ttm-total td { font-weight: bold; border-top: 2px solid #bbb; }
+  #ttm td.ttm-note { color: #555; font-size: 92%; }
+  #ttm tr.ttm-empty td { color: #aaa; }
+  #ttm .ttm-grid-wrap { overflow-x: auto; }
+  #ttm table.ttm-grid th.cell, #ttm table.ttm-grid td.cell { text-align: right; min-width: 46px; white-space: nowrap; }
+  #ttm table.ttm-grid .we { background: #f6f6f6; }
+  #ttm table.ttm-grid th.we { background: #e4e4e4; }
+  #ttm table.ttm-grid td.item { min-width: 260px; }
+  #ttm table.ttm-grid td.item, #ttm table.ttm-grid th:first-child, #ttm table.ttm-grid tr.ttm-total td:first-child {
+      position: sticky; left: 0; z-index: 1; background: #fff; box-shadow: 1px 0 0 #e5e5e5; }
