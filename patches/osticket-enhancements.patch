diff --git a/scp/css/custom.css b/scp/css/custom.css
new file mode 100644
index 0000000..8e9179c
--- /dev/null
+++ b/scp/css/custom.css
@@ -0,0 +1,40 @@
+/*
+ * Local customizations for osTicket (staff panel).
+ * Loaded after scp.css from include/staff/header.inc.php.
+ */
+
+/* 1. Full-width staff layout (stock is fixed at 960px) */
+#container {
+    width: auto;
+    margin: 0 15px 20px 15px;
+}
+.jb-overflowmenu {
+    width: auto;
+}
+/* Templates hard-code width="940" on ticket lists, ticket view and
+   most other tables; stretch them to the container. */
+#content table[width="940"] {
+    width: 100%;
+}
+
+/* Rich-text editors (Post Reply, Internal Note, task updates): osTicket
+   limits the typing area to 950px and centres it, which leaves it floating
+   in the middle of a full-width page. Use the full width of the box. */
+.redactor-box .redactor-styles {
+    max-width: none !important;
+    margin-left: 0 !important;
+    margin-right: 0 !important;
+}
+
+/* Taller reply / note / task-update editors, resizable by dragging the
+   bottom-right corner. (Stock height is 150px.) */
+#reply .redactor-box .redactor-styles,
+#note .redactor-box .redactor-styles,
+#task_reply .redactor-box .redactor-styles,
+#task_note .redactor-box .redactor-styles {
+    min-height: 300px !important;
+}
+.redactor-box .redactor-styles {
+    resize: vertical;
+    overflow-y: auto;
+}
