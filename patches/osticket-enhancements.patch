diff --git a/include/plugins/time-tracking/agentreport.php b/include/plugins/time-tracking/agentreport.php
new file mode 100644
index 0000000..6f68a24
--- /dev/null
+++ b/include/plugins/time-tracking/agentreport.php
@@ -0,0 +1,331 @@
+<?php
+/*********************************************************************
+ * My Time report (part of the Time & Cost Tracking plugin)
+ *
+ * Staff page: scp/mytime.php (Dashboard > My Time)
+ *
+ * Every time / cost entry one agent logged in a period (this / last week,
+ * month, quarter, year, or custom dates), as
+ *
+ *  - Entries:   totals, a per-day (or per-week / per-month) summary and
+ *               every entry with its ticket, task, category and note
+ *  - Timesheet: tickets and tasks down the side, days (or weeks / months
+ *               for longer periods) across the top, hours in the cells
+ *
+ * with Excel (both sheets) and CSV exports and a print layout.
+ *
+ * Access: every agent sees their own time. Department managers can pick
+ * agents whose primary department they manage; admins can pick anyone.
+ * Opening totals imported from hand-entered values have no agent and are
+ * not included.
+ *********************************************************************/
+
+class AgentTimeReport {
+
+    static function enabled() {
+        return TimeReports::enabled();
+    }
+
+    static function canView($staff) {
+        return $staff && self::enabled();
+    }
+
+    /** staff_id => name of the agents $staff may report on (self first) */
+    static function agentsFor($staff) {
+        $list = array((int) $staff->getId() => (string) $staff->getName());
+        $q = null;
+        if ($staff->isAdmin())
+            $q = Staff::objects();
+        else {
+            $depts = array();
+            foreach (Dept::objects()->filter(array('manager_id' => $staff->getId()))
+                    ->values_flat('id') as $row)
+                $depts[] = (int) $row[0];
+            if ($depts)
+                $q = Staff::objects()->filter(array('dept_id__in' => $depts));
+        }
+        if ($q) {
+            $others = array();
+            foreach ($q->filter(array('isactive' => 1))
+                    ->values_flat('staff_id', 'firstname', 'lastname') as $r)
+                if ((int) $r[0] !== (int) $staff->getId())
+                    $others[(int) $r[0]] = trim($r[1] . ' ' . $r[2]);
+            asort($others, SORT_NATURAL | SORT_FLAG_CASE);
+            $list += $others;
+        }
+        return $list;
+    }
+
+    /* ---------------------------------------------------------------
+     * Periods
+     * ------------------------------------------------------------- */
+
+    static function periods() {
+        return array(
+            'this_week'    => 'This Week',
+            'last_week'    => 'Last Week',
+            'this_month'   => 'This Month',
+            'last_month'   => 'Last Month',
+            'this_quarter' => 'This Quarter',
+            'last_quarter' => 'Last Quarter',
+            'this_year'    => 'This Year',
+            'last_year'    => 'Last Year',
+            'custom'       => 'Custom Dates',
+        );
+    }
+
+    /** Start of the week containing $d (00:00) */
+    static function weekStart($d) {
+        $d = (clone $d)->setTime(0, 0, 0);
+        $dow = (int) $d->format('N');           // 1 = Monday .. 7 = Sunday
+        $back = TimeTrackingPlugin::$opts['week_start'] === 'sun' ? $dow % 7 : $dow - 1;
+        return $d->modify("-{$back} days");
+    }
+
+    /** array(start, end (exclusive), label); never open-ended */
+    static function resolve($key, $from='', $to='') {
+        $tz = TimeReports::userTz();
+        $now = new DateTime('now', $tz);
+        switch ($key) {
+        case 'this_week':
+        case 'last_week':
+            $s = self::weekStart($now);
+            if ($key === 'last_week')
+                $s->modify('-7 days');
+            $e = (clone $s)->modify('+7 days');
+            return array($s, $e, 'Week of ' . $s->format('M j, Y'));
+        case 'custom':
+            list($s, $e, $label) = TimeReports::resolve('custom', $from, $to);
+            if ($s && $e)
+                return array($s, $e, $label);
+            // Incomplete custom range: fall back to this week
+            return self::resolve('this_week');
+        default:
+            return TimeReports::resolve($key);
+        }
+    }
+
+    /**
+     * Column grouping for the period: 'day' up to 31 days, 'week' up to
+     * 26 weeks, otherwise 'month'. Returns array(unit, buckets) where
+     * buckets is array(key => array(label, start DateTime, weekend)).
+     */
+    static function buckets($start, $end) {
+        $days = (int) round(($end->getTimestamp() - $start->getTimestamp()) / 86400);
+        $unit = $days <= 31 ? 'day' : ($days <= 182 ? 'week' : 'month');
+        $out = array();
+        if ($unit === 'day') {
+            for ($d = clone $start; $d < $end; $d->modify('+1 day'))
+                $out[$d->format('Y-m-d')] = array($d->format('D n/j'), clone $d,
+                    (int) $d->format('N') >= 6);
+        }
+        elseif ($unit === 'week') {
+            for ($d = self::weekStart($start); $d < $end; $d->modify('+7 days'))
+                $out[$d->format('Y-m-d')] = array('Wk ' . $d->format('n/j'), clone $d, false);
+        }
+        else {
+            $d = (clone $start)->modify('first day of this month')->setTime(0, 0, 0);
+            for (; $d < $end; $d->modify('+1 month'))
+                $out[$d->format('Y-m')] = array($d->format('M Y'), clone $d, false);
+        }
+        return array($unit, $out);
+    }
+
+    static function bucketKey($unit, $dt) {
+        if ($unit === 'day')
+            return $dt->format('Y-m-d');
+        if ($unit === 'week')
+            return self::weekStart($dt)->format('Y-m-d');
+        return $dt->format('Y-m');
+    }
+
+    /* ---------------------------------------------------------------
+     * Data
+     * ------------------------------------------------------------- */
+
+    /** One agent's entries in [start, end), oldest first */
+    static function entries($staffId, $start, $end) {
+        if (!TimeTrackingPlugin::ensureSchema())
+            return array();
+        $P = TABLE_PREFIX;
+        $sql = sprintf("SELECT e.id, e.object_type, e.object_id, e.ticket_id, e.minutes, e.cost,
+                    e.created, t.number AS tnum, tc.subject, k.number AS knum, kc.title AS ktitle,
+                    te.title AS etitle, te.body AS ebody
+                FROM `%s` e
+                LEFT JOIN `{$P}ticket` t ON (e.ticket_id > 0 AND t.ticket_id = e.ticket_id)
+                LEFT JOIN `{$P}ticket__cdata` tc ON (tc.ticket_id = t.ticket_id)
+                LEFT JOIN `{$P}task` k ON (e.object_type = 'A' AND k.id = e.object_id)
+                LEFT JOIN `{$P}task__cdata` kc ON (kc.task_id = k.id)
+                LEFT JOIN `{$P}thread_entry` te ON (e.thread_entry_id > 0 AND te.id = e.thread_entry_id)
+                WHERE e.staff_id = %d AND e.kind = 'entry'
+                  AND e.created >= %s AND e.created < %s
+                ORDER BY e.created, e.id",
+            TimeTrackingPlugin::table(), $staffId,
+            db_input(TimeReports::toDb($start)), db_input(TimeReports::toDb($end)));
+        $rows = array();
+        $tids = array();
+        $res = db_query($sql);
+        while ($res && ($r = db_fetch_array($res))) {
+            $r['when'] = TimeReports::fromDb($r['created']);
+            $r['note'] = self::excerpt($r['ebody'] ?: $r['etitle']);
+            if ((int) $r['ticket_id'])
+                $tids[(int) $r['ticket_id']] = 1;
+            $rows[] = $r;
+        }
+        $cats = TimeReports::categories(array_keys($tids));
+        foreach ($rows as &$r) {
+            $tid = (int) $r['ticket_id'];
+            $r['category'] = $tid ? (isset($cats[$tid]) ? $cats[$tid] : '') : '';
+            $r['ticket'] = $tid ? ($r['tnum'] ? '#' . $r['tnum'] : '(deleted ticket)') : '';
+            $r['task'] = $r['object_type'] === 'A'
+                ? ($r['knum'] ? 'Task #' . $r['knum'] : '(deleted task)') : '';
+            $r['title'] = $r['object_type'] === 'A' ? (string) $r['ktitle'] : (string) $r['subject'];
+        }
+        unset($r);
+        return $rows;
+    }
+
+    /** Plain-text start of a thread entry body */
+    static function excerpt($html, $len=140) {
+        $t = html_entity_decode(strip_tags(preg_replace('#<(br|/p|/div|/li)\b[^>]*>#i', ' ', (string) $html)),
+            ENT_QUOTES, 'UTF-8');
+        $t = trim(preg_replace('/\s+/u', ' ', $t));
+        return mb_strlen($t) > $len ? mb_substr($t, 0, $len - 1) . '…' : $t;
+    }
+
+    /** Totals, per-bucket summary and timesheet grid for $rows */
+    static function build($rows, $unit, $buckets) {
+        $total = array('minutes' => 0, 'cost' => 0.0, 'entries' => count($rows), 'items' => 0);
+        $summary = array();
+        foreach ($buckets as $k => $b)
+            $summary[$k] = array('minutes' => 0, 'cost' => 0.0, 'entries' => 0);
+        $grid = array();
+        foreach ($rows as $r) {
+            $m = (int) $r['minutes']; $c = (float) $r['cost'];
+            $total['minutes'] += $m; $total['cost'] += $c;
+            $k = self::bucketKey($unit, $r['when']);
+            if (isset($summary[$k])) {
+                $summary[$k]['minutes'] += $m; $summary[$k]['cost'] += $c;
+                $summary[$k]['entries']++;
+            }
+            // Timesheet row per ticket (own time) and per task
+            $item = (int) $r['ticket_id'] . ':' . ($r['object_type'] === 'A' ? (int) $r['object_id'] : 0);
+            if (!isset($grid[$item]))
+                $grid[$item] = array(
+                    'ticket' => $r['ticket'], 'task' => $r['task'],
+                    'subject' => (string) $r['subject'], 'title' => $r['title'],
+                    'category' => $r['category'],
+                    'sort' => sprintf('%s|%s|%010d', $r['tnum'] ?: 'zz', $r['task'] ? 1 : 0,
+                        $r['object_type'] === 'A' ? (int) $r['knum'] : 0),
+                    'cells' => array(), 'minutes' => 0, 'cost' => 0.0);
+            $g =& $grid[$item];
+            $g['cells'][$k] = (isset($g['cells'][$k]) ? $g['cells'][$k] : 0) + $m;
+            $g['minutes'] += $m; $g['cost'] += $c;
+            unset($g);
+        }
+        uasort($grid, function($a, $b) { return strnatcasecmp($a['sort'], $b['sort']); });
+        $total['items'] = count($grid);
+        return array($total, $summary, $grid);
+    }
+
+    /* ---------------------------------------------------------------
+     * Export
+     * ------------------------------------------------------------- */
+
+    static function entryColumns() {
+        return array('Date' => 'd', 'Ticket' => 's', 'Subject' => 's', 'Task' => 's',
+            'Task Title' => 's', 'Category' => 's', 'Note' => 's', 'Hours' => 'h', 'Cost' => 'm');
+    }
+
+    static function entryRows($rows) {
+        $out = array();
+        foreach ($rows as $r)
+            $out[] = array('Date' => $r['when'], 'Ticket' => $r['ticket'],
+                'Subject' => (string) $r['subject'], 'Task' => $r['task'],
+                'Task Title' => $r['task'] ? (string) $r['ktitle'] : '',
+                'Category' => $r['category'], 'Note' => $r['note'],
+                'Hours' => round($r['minutes'] / 60, 2), 'Cost' => round((float) $r['cost'], 2));
+        return $out;
+    }
+
+    static function gridColumns($buckets) {
+        $cols = array('Ticket / Task' => 's', 'Category' => 's');
+        foreach ($buckets as $b)
+            $cols[$b[0]] = 'h';
+        return $cols + array('Total Hours' => 'h', 'Cost' => 'm');
+    }
+
+    static function gridLabel($g) {
+        $l = $g['ticket'] ?: '';
+        if ($g['task'])
+            $l .= ($l ? ' › ' : '') . $g['task'];
+        return trim($l . ' — ' . $g['title'], ' —');
+    }
+
+    static function gridRows($grid, $buckets) {
+        $out = array();
+        foreach ($grid as $g) {
+            $row = array('Ticket / Task' => self::gridLabel($g), 'Category' => $g['category']);
+            foreach ($buckets as $k => $b)
+                if (!empty($g['cells'][$k]))
+                    $row[$b[0]] = round($g['cells'][$k] / 60, 2);
+            $row['Total Hours'] = round($g['minutes'] / 60, 2);
+            $row['Cost'] = round($g['cost'], 2);
+            $out[] = $row;
+        }
+        return $out;
+    }
+
+    static function fileName($agent, $label, $ext, $suffix='') {
+        return 'my-time-' . trim(preg_replace('/[^A-Za-z0-9]+/', '-', $agent . ' ' . $label), '-')
+            . ($suffix ? '-' . $suffix : '') . '.' . $ext;
+    }
+
+    /* ---------------------------------------------------------------
+     * Page
+     * ------------------------------------------------------------- */
+
+    /** Called from scp/mytime.php after staff.inc.php */
+    static function page() {
+        global $thisstaff, $ost, $nav, $cfg;
+        if (!self::canView($thisstaff))
+            Http::response(403, __('Access Denied'));
+
+        $agents = self::agentsFor($thisstaff);
+        $agentId = isset($_GET['agent']) ? (int) $_GET['agent'] : (int) $thisstaff->getId();
+        if (!isset($agents[$agentId]))
+            Http::response(403, __('Access Denied'));
+        $agentName = $agents[$agentId];
+
+        $periods = self::periods();
+        $period = isset($periods[@$_GET['period']]) ? $_GET['period'] : 'this_week';
+        list($start, $end, $label) = self::resolve($period, @$_GET['from'], @$_GET['to']);
+        $view = @$_GET['view'] === 'timesheet' ? 'timesheet' : 'entries';
+
+        $rows = self::entries($agentId, $start, $end);
+        list($unit, $buckets) = self::buckets($start, $end);
+        list($total, $summary, $grid) = self::build($rows, $unit, $buckets);
+
+        switch (@$_GET['export']) {
+        case 'xlsx':
+            if (class_exists('ZipArchive'))
+                TimeReports::sendWorkbook(array(
+                    'Entries' => TimeReports::sheetXml(self::entryColumns(), self::entryRows($rows)),
+                    'Timesheet' => TimeReports::sheetXml(self::gridColumns($buckets),
+                        self::gridRows($grid, $buckets)),
+                ), self::fileName($agentName, $label, 'xlsx'));
+            // no ZipArchive: fall through to CSV
+        case 'csv':
+            if (@$_GET['layout'] === 'timesheet')
+                TimeReports::sendCsvRows(self::gridColumns($buckets), self::gridRows($grid, $buckets),
+                    self::fileName($agentName, $label, 'csv', 'timesheet'));
+            TimeReports::sendCsvRows(self::entryColumns(), self::entryRows($rows),
+                self::fileName($agentName, $label, 'csv', 'entries'));
+        }
+
+        $nav->setTabActive('dashboard');
+        require STAFFINC_DIR . 'header.inc.php';
+        include __DIR__ . '/agentreport.tmpl.php';
+        include STAFFINC_DIR . 'footer.inc.php';
+    }
+}
