diff --git a/include/plugins/sub-tasks/subtasks.php b/include/plugins/sub-tasks/subtasks.php
new file mode 100644
index 0000000..0ab735e
--- /dev/null
+++ b/include/plugins/sub-tasks/subtasks.php
@@ -0,0 +1,460 @@
+<?php
+/*********************************************************************
+ * Sub-tasks plugin for osTicket 1.17 / 1.18
+ *
+ * A sub-task is an ordinary osTicket task on the same ticket (or a
+ * standalone task under a standalone task). The plugin only records which
+ * task it sits under, in %TABLE_PREFIX%task_subtask:
+ *
+ *   task_id    the sub-task
+ *   parent_id  the task it belongs under
+ *
+ * One level only: a sub-task cannot have sub-tasks of its own.
+ *
+ *  - Task view: a Sub-tasks panel (status, assignee, time / cost when the
+ *    Time & Cost plugin is active) with an "Add Sub-task" button, and a
+ *    "Sub-task of" line on each sub-task.
+ *  - Ticket: sub-tasks are listed under their parent on the Tasks tab and
+ *    in the Time & Cost summary.
+ *  - An existing task can be moved under another task ("Make this a
+ *    sub-task of..."), moved to another parent, or made top-level again.
+ *  - A parent cannot be completed while sub-tasks are open; reopening a
+ *    sub-task reopens a completed parent (both optional).
+ *
+ * Nothing else is stored, and osTicket's own tables are not changed.
+ * Disabling the plugin shows sub-tasks as a flat list of tasks again;
+ * DROP TABLE %TABLE_PREFIX%task_subtask removes the links for good.
+ *********************************************************************/
+
+require_once INCLUDE_DIR . 'class.plugin.php';
+require_once INCLUDE_DIR . 'class.signal.php';
+require_once __DIR__ . '/config.php';
+
+class SubTasksPlugin extends Plugin {
+    var $config_class = 'SubTasksConfig';
+
+    static $opts = null;
+    static $schemaOk = false;
+    static $parentCache = array();
+    static $reopening = false;
+
+    function isMultiInstance() {
+        return false;
+    }
+
+    function bootstrap() {
+        $c = $this->getConfig();
+        self::$opts = array(
+            'block_close' => !$c->get('allow_close'),
+            'reopen_parent' => !$c->get('no_reopen'),
+            'same_dept' => !$c->get('any_dept'),
+        );
+        Signal::connect('task.created', array(__CLASS__, 'onTaskCreated'));
+        Signal::connect('task.closeable', array(__CLASS__, 'onCloseable'));
+        Signal::connect('model.updated', array(__CLASS__, 'onTaskUpdated'), 'Task');
+        Signal::connect('model.deleted', array(__CLASS__, 'onTaskDeleted'), 'Task');
+        Signal::connect('object.view', array(__CLASS__, 'onTaskView'), 'Task');
+        Signal::connect('object.view', array(__CLASS__, 'onTicketView'), 'Ticket');
+        Signal::connect('ajax.scp', function($dispatcher) {
+            $dispatcher->append(url_post('^/subtasks/(?P<id>\d+)/parent$',
+                function($id) { SubTasksPlugin::ajaxSetParent($id); }));
+        });
+    }
+
+    /** True when the plugin is enabled (for other plugins) */
+    static function active() {
+        return self::$opts !== null && self::ensureSchema();
+    }
+
+    /* ---------------------------------------------------------------
+     * Storage
+     * ------------------------------------------------------------- */
+
+    static function table() {
+        return TABLE_PREFIX . 'task_subtask';
+    }
+
+    static function ensureSchema() {
+        if (self::$schemaOk)
+            return true;
+        return self::$schemaOk = (bool) db_query('CREATE TABLE IF NOT EXISTS `'
+            . self::table() . '` (
+              `task_id` int(11) unsigned NOT NULL,
+              `parent_id` int(11) unsigned NOT NULL,
+              `created` datetime NOT NULL,
+              PRIMARY KEY (`task_id`),
+              KEY `parent_id` (`parent_id`)
+            ) DEFAULT CHARSET=utf8');
+    }
+
+    /** Parent task id of a sub-task, or 0 */
+    static function parentOf($taskId) {
+        $taskId = (int) $taskId;
+        if (!array_key_exists($taskId, self::$parentCache)) {
+            self::$parentCache[$taskId] = 0;
+            if (self::ensureSchema()
+                    && ($res = db_query(sprintf('SELECT parent_id FROM `%s` WHERE task_id=%d',
+                        self::table(), $taskId)))
+                    && ($row = db_fetch_array($res)))
+                self::$parentCache[$taskId] = (int) $row['parent_id'];
+        }
+        return self::$parentCache[$taskId];
+    }
+
+    /** Sub-task ids of a task, oldest first */
+    static function childIds($parentId) {
+        $ids = array();
+        if (self::ensureSchema()
+                && ($res = db_query(sprintf('SELECT task_id FROM `%s` WHERE parent_id=%d ORDER BY task_id',
+                    self::table(), $parentId))))
+            while ($row = db_fetch_array($res))
+                $ids[] = (int) $row['task_id'];
+        return $ids;
+    }
+
+    static function children($parentId) {
+        $ids = self::childIds($parentId);
+        if (!$ids)
+            return array();
+        return Task::objects()->filter(array('id__in' => $ids))->order_by('id')->all();
+    }
+
+    /** array(child id => parent id) for the given task ids */
+    static function parentMap($ids) {
+        $ids = array_filter(array_map('intval', (array) $ids));
+        $map = array();
+        if (!$ids || !self::ensureSchema())
+            return $map;
+        $res = db_query(sprintf('SELECT task_id, parent_id FROM `%s` WHERE task_id IN (%s)',
+            self::table(), implode(',', $ids)));
+        while ($res && ($row = db_fetch_array($res)))
+            $map[(int) $row['task_id']] = (int) $row['parent_id'];
+        return $map;
+    }
+
+    /**
+     * Order task ids so each sub-task follows its parent. Returns
+     * array(id => parent id or 0). Sub-tasks whose parent isn't in the
+     * list are shown as top-level.
+     */
+    static function order($ids) {
+        $ids = array_values(array_map('intval', (array) $ids));
+        $map = self::parentMap($ids);
+        $in = array_flip($ids);
+        $kids = array();
+        foreach ($ids as $id)
+            if (isset($map[$id]) && isset($in[$map[$id]]))
+                $kids[$map[$id]][] = $id;
+        $out = array();
+        foreach ($ids as $id) {
+            if (isset($map[$id]) && isset($in[$map[$id]]))
+                continue;
+            $out[$id] = 0;
+            foreach ((array) @$kids[$id] as $k)
+                $out[$k] = $id;
+        }
+        return $out;
+    }
+
+    static function link($taskId, $parentId) {
+        if (!self::ensureSchema())
+            return false;
+        self::$parentCache[(int) $taskId] = (int) $parentId;
+        return db_query(sprintf(
+            'INSERT INTO `%s` (task_id, parent_id, created) VALUES (%d, %d, NOW())
+             ON DUPLICATE KEY UPDATE parent_id=VALUES(parent_id)',
+            self::table(), $taskId, $parentId));
+    }
+
+    static function unlink($taskId) {
+        if (!self::ensureSchema())
+            return false;
+        self::$parentCache[(int) $taskId] = 0;
+        return db_query(sprintf('DELETE FROM `%s` WHERE task_id=%d', self::table(), $taskId));
+    }
+
+    /** Same ticket, or both standalone */
+    static function sameContainer($a, $b) {
+        return (string) $a->object_type === (string) $b->object_type
+            && (int) $a->object_id === (int) $b->object_id;
+    }
+
+    /** Tasks a new sub-task may be placed under (open, top-level, same container) */
+    static function eligibleParents($task) {
+        $list = array();
+        if ($task->object_type === ObjectModel::OBJECT_TYPE_TICKET && $task->object_id) {
+            $tasks = Task::objects()->filter(array(
+                'object_type' => ObjectModel::OBJECT_TYPE_TICKET,
+                'object_id' => $task->object_id))->order_by('id')->all();
+            $map = self::parentMap(array_map(function($t) { return $t->getId(); }, $tasks));
+            foreach ($tasks as $t)
+                if ($t->isOpen() && !isset($map[$t->getId()]))
+                    $list[] = $t;
+        }
+        else
+            $list[] = $task;
+        return $list;
+    }
+
+    static function canAddTo($task) {
+        global $thisstaff;
+        if (!$thisstaff || self::parentOf($task->getId()))
+            return false;
+        if ($task->object_type === ObjectModel::OBJECT_TYPE_TICKET && $task->object_id) {
+            $ticket = Ticket::lookup($task->object_id);
+            return $ticket && $ticket->checkStaffPerm($thisstaff, Task::PERM_CREATE);
+        }
+        $role = $thisstaff->getRole($task->getDept());
+        return $role && $role->hasPerm(Task::PERM_CREATE);
+    }
+
+    /** Why $task can't go under $parent, or null if it can */
+    static function checkParent($task, $parent) {
+        global $thisstaff;
+        if (!$parent)
+            return 'Parent task not found';
+        if ($parent->getId() == $task->getId())
+            return 'A task cannot be its own sub-task';
+        if (self::parentOf($parent->getId()))
+            return sprintf('Task #%s is itself a sub-task (one level only)', $parent->getNumber());
+        if (self::childIds($task->getId()))
+            return sprintf('Task #%s has sub-tasks of its own (one level only)', $task->getNumber());
+        if (!self::sameContainer($parent, $task))
+            return 'The parent belongs to a different ticket';
+        if ($thisstaff && !$parent->checkStaffPerm($thisstaff))
+            return 'No access to the parent task';
+        return null;
+    }
+
+    /** Note on the parent's thread, without alerts */
+    static function noteOnParent($parent, $task, $title) {
+        global $thisstaff;
+        $errors = array();
+        $parent->postNote(array(
+            'title' => sprintf($title, $task->getNumber()),
+            'note' => sprintf('<a href="tasks.php?id=%d"><b>#%s</b></a> &mdash; %s',
+                $task->getId(), $task->getNumber(), Format::htmlchars($task->getTitle())),
+        ), $errors, $thisstaff, false);
+    }
+
+    /** POST ajax.php/subtasks/{id}/parent  parent=<task id> (empty = top-level) */
+    static function ajaxSetParent($id) {
+        global $thisstaff;
+        if (!$thisstaff)
+            Http::response(403, 'Login required');
+        if (!($task = Task::lookup((int) $id)) || !$task->checkStaffPerm($thisstaff))
+            Http::response(404, 'No such task');
+        if (!$task->checkStaffPerm($thisstaff, Task::PERM_EDIT))
+            Http::response(403, 'You do not have permission to edit this task');
+        if (!self::ensureSchema())
+            Http::response(500, 'Unable to save');
+
+        $old = self::parentOf($task->getId());
+        $pid = (int) @$_POST['parent'];
+        if ($pid && $pid !== $old) {
+            $parent = Task::lookup($pid);
+            if ($why = self::checkParent($task, $parent))
+                Http::response(422, Format::htmlchars($why));
+            self::link($task->getId(), $pid);
+            if ($old && ($o = Task::lookup($old)))
+                self::noteOnParent($o, $task, __('Sub-task #%s moved to another task'));
+            self::noteOnParent($parent, $task, __('Sub-task #%s added'));
+            if (self::$opts['reopen_parent'] && $parent->isClosed() && $task->isOpen())
+                self::reopen($parent);
+        }
+        elseif (!$pid && $old) {
+            self::unlink($task->getId());
+            if ($o = Task::lookup($old))
+                self::noteOnParent($o, $task, __('Sub-task #%s made a top-level task'));
+        }
+        Http::response(200, JsonDataEncoder::encode(array('ok' => true,
+            'parent' => self::parentOf($task->getId()))), 'application/json');
+    }
+
+    /* ---------------------------------------------------------------
+     * Signal handlers
+     * ------------------------------------------------------------- */
+
+    /** A task created from the "Add Sub-task" dialog (st_parent posted) */
+    static function onTaskCreated($task) {
+        global $thisstaff, $ost;
+        $pid = (int) @$_POST['st_parent'];
+        if (!$pid || !$thisstaff)
+            return;
+        $parent = Task::lookup($pid);
+        $why = self::checkParent($task, $parent);
+        if ($why) {
+            $ost->logWarning('Sub-tasks', sprintf('Task #%s was created as a regular task: %s.',
+                $task->getNumber(), $why), false);
+            return;
+        }
+        self::link($task->getId(), $pid);
+        self::noteOnParent($parent, $task, __('Sub-task #%s added'));
+
+        // An open sub-task under a completed parent: reopen the parent
+        if (self::$opts['reopen_parent'] && $parent->isClosed() && $task->isOpen())
+            self::reopen($parent);
+    }
+
+    static function reopen($task) {
+        if (self::$reopening)
+            return;
+        self::$reopening = true;
+        $errors = array();
+        $task->setStatus('open', '', $errors);
+        self::$reopening = false;
+    }
+
+    /** Veto completing a parent while sub-tasks are open */
+    static function onCloseable($task, &$data) {
+        if (!self::$opts['block_close'] || !empty($data['warning']))
+            return;
+        $open = 0;
+        foreach (self::children($task->getId()) as $c)
+            if ($c->isOpen()) $open++;
+        if ($open)
+            $data['warning'] = sprintf(_N('This task has %d open sub-task and cannot be completed',
+                'This task has %d open sub-tasks and cannot be completed', $open), $open);
+    }
+
+    /** Reopening a sub-task reopens its completed parent */
+    static function onTaskUpdated($task, &$data) {
+        if (!self::$opts['reopen_parent'] || !isset($data['dirty'])
+                || !array_key_exists('flags', $data['dirty']))
+            return;
+        $wasOpen = (bool) ((int) $data['dirty']['flags'] & TaskModel::ISOPEN);
+        if ($wasOpen || !$task->isOpen())
+            return;
+        if (($pid = self::parentOf($task->getId())) && ($parent = Task::lookup($pid))
+                && $parent->isClosed())
+            self::reopen($parent);
+    }
+
+    /** Deleted task: drop its link; its sub-tasks become regular tasks */
+    static function onTaskDeleted($task, &$data=null) {
+        if (!self::ensureSchema())
+            return;
+        $id = (int) $task->getId();
+        db_query(sprintf('DELETE FROM `%s` WHERE task_id=%d OR parent_id=%d',
+            self::table(), $id, $id));
+        unset(self::$parentCache[$id]);
+    }
+
+    /* ---------------------------------------------------------------
+     * Views
+     * ------------------------------------------------------------- */
+
+    static function timeInfo($taskId) {
+        if (!class_exists('TimeTrackingPlugin', false) || !TimeTrackingPlugin::$opts
+                || !TimeTrackingPlugin::ensureSchema())
+            return null;
+        list($m, $c) = TimeTrackingPlugin::totals('A', $taskId);
+        return array_merge(array('minutes' => $m, 'amount' => $c),
+            TimeTrackingPlugin::fmtPair($m, $c));
+    }
+
+    static function taskInfo($t) {
+        $assigned = $t->getAssigned();
+        $info = array(
+            'id' => (int) $t->getId(),
+            'number' => (string) $t->getNumber(),
+            'title' => (string) $t->getTitle(),
+            'status' => (string) $t->getStatus(),
+            'open' => (bool) $t->isOpen(),
+            'assignee' => $assigned ? (string) $assigned : '',
+        );
+        if ($ti = self::timeInfo($t->getId()))
+            $info += array('time' => $ti['time'], 'cost' => $ti['cost'],
+                'minutes' => $ti['minutes'], 'amount' => $ti['amount']);
+        return $info;
+    }
+
+    static function onTaskView($task, &$data=null) {
+        global $thisstaff;
+        if (!self::$opts || !$thisstaff || !defined('OSTSCPINC') || !self::ensureSchema())
+            return;
+
+        $id = (int) $task->getId();
+        $ticketId = $task->object_type === ObjectModel::OBJECT_TYPE_TICKET
+            ? (int) $task->object_id : 0;
+        // Opened inside the ticket view (loaded by ajax.php/tickets/...)
+        $inTicket = $ticketId && strpos(@$_SERVER['REQUEST_URI'], 'ajax.php/tickets/') !== false;
+
+        $cfg = array(
+            'id' => $id,
+            'returnUrl' => $inTicket
+                ? sprintf('tickets.php?id=%d#tasks', $ticketId)
+                : sprintf('tasks.php?id=%d', $id),
+            'number' => (string) $task->getNumber(),
+            'inTicket' => $inTicket,
+            'hasTime' => self::timeInfo($id) !== null,
+        );
+        if ($pid = self::parentOf($id)) {
+            if ($p = Task::lookup($pid))
+                $cfg['parent'] = self::taskInfo($p);
+        }
+        else {
+            $cfg['own'] = self::timeInfo($id);
+            $cfg['children'] = array();
+            $tm = $cfg['own'] ? $cfg['own']['minutes'] : 0;
+            $tc = $cfg['own'] ? $cfg['own']['amount'] : 0;
+            foreach (self::children($id) as $c) {
+                $i = self::taskInfo($c);
+                $cfg['children'][] = $i;
+                $tm += @$i['minutes']; $tc += @$i['amount'];
+            }
+            if ($cfg['hasTime'])
+                $cfg['total'] = TimeTrackingPlugin::fmtPair($tm, $tc);
+            $cfg['canAdd'] = $task->isOpen() && self::canAddTo($task);
+            if ($cfg['canAdd']) {
+                $cfg['addUrl'] = $ticketId
+                    ? sprintf('ajax.php/tickets/%d/add-task', $ticketId) : 'ajax.php/tasks/add';
+                $cfg['formAction'] = $ticketId
+                    ? sprintf('#tickets/%d/add-task', $ticketId) : '#tasks/add';
+                $cfg['parents'] = array();
+                foreach (self::eligibleParents($task) as $p)
+                    $cfg['parents'][] = array('id' => (int) $p->getId(),
+                        'label' => sprintf('Task #%s — %s', $p->getNumber(), $p->getTitle()));
+                $cfg['deptId'] = self::$opts['same_dept'] ? (int) $task->getDeptId() : 0;
+            }
+        }
+        // Move: make this task a sub-task / change parent / make top-level
+        if ($task->checkStaffPerm($thisstaff, Task::PERM_EDIT) && empty($cfg['children'])) {
+            $targets = array();
+            foreach (self::eligibleParents($task) as $p)
+                if ($p->getId() != $id)
+                    $targets[] = array('id' => (int) $p->getId(),
+                        'label' => sprintf('Task #%s — %s', $p->getNumber(), $p->getTitle()));
+            if ($pid && ($p = Task::lookup($pid)) && $p->isClosed())
+                array_unshift($targets, array('id' => (int) $p->getId(),
+                    'label' => sprintf('Task #%s — %s', $p->getNumber(), $p->getTitle())));
+            if ($targets || $pid) {
+                $cfg['moveTargets'] = $targets;
+                $cfg['moveUrl'] = sprintf('ajax.php/subtasks/%d/parent', $id);
+            }
+        }
+        $json = json_encode($cfg, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
+        include __DIR__ . '/view.inc.php';
+    }
+
+    /** Ticket view: nest sub-tasks under their parent on the Tasks tab */
+    static function onTicketView($ticket, &$data=null) {
+        global $thisstaff;
+        if (!self::$opts || !$thisstaff || !defined('OSTSCPINC') || !self::ensureSchema())
+            return;
+        $ids = array();
+        foreach (Task::objects()->filter(array(
+                'object_type' => ObjectModel::OBJECT_TYPE_TICKET,
+                'object_id' => $ticket->getId()))->values_flat('id') as $row)
+            $ids[] = (int) $row[0];
+        $map = self::parentMap($ids);
+        if (!$map)
+            return;
+        $counts = array();
+        foreach ($map as $c => $p)
+            $counts[$p] = (isset($counts[$p]) ? $counts[$p] : 0) + 1;
+        $json = json_encode(array('ticketId' => (int) $ticket->getId(),
+            'map' => (object) $map, 'counts' => (object) $counts));
+        include __DIR__ . '/ticket.inc.php';
+    }
+}
diff --git a/include/plugins/sub-tasks/ticket.inc.php b/include/plugins/sub-tasks/ticket.inc.php
new file mode 100644
index 0000000..0a6417c
--- /dev/null
+++ b/include/plugins/sub-tasks/ticket.inc.php
@@ -0,0 +1,64 @@
+<?php
+// Rendered at the top of the staff ticket view (object.view signal).
+// Expects $json from SubTasksPlugin::onTicketView(): which of the ticket's
+// tasks are sub-tasks, so the Tasks tab can list them under their parent.
+if (!defined('OSTSCPINC')) die('Access Denied');
+?>
+<style type="text/css">
+  tr.st-row > td { background: #fafcff; }
+  td.st-title { padding-left: 26px !important; }
+  .st-arrow { color: #999; margin-right: 4px; }
+  .st-chip { display: inline-block; background: #eef4fa; border: 1px solid #cfe0f0; color: #2a5d8f;
+      border-radius: 9px; padding: 0 7px; font-size: 11px; line-height: 16px; margin-left: 6px; font-weight: normal; }
+</style>
+<script type="text/javascript">
+(function($) {
+  var cfg = <?php echo $json; ?>;
+
+  function nest() {
+    var $tbody = $('form#tasks[action="#tickets/' + cfg.ticketId + '/tasks"] tbody.tasks').first();
+    if (!$tbody.length || $tbody.data('st-done')) return;
+    $tbody.data('st-done', 1);
+    var rows = {};
+    $tbody.children('tr[id]').each(function() { rows[this.id] = $(this); });
+    // Parent rows (in their current order), each followed by its sub-tasks
+    $.each(rows, function(id, $row) {
+      if (cfg.map[id]) return;
+      var n = cfg.counts[id];
+      if (!n) return;
+      var $title = $row.find('a[href$="/tasks/' + id + '/view"]').not('.preview').first();
+      $title.after(' <span class="st-chip">' + n + ' sub-task' + (n > 1 ? 's' : '') + '</span>');
+      var $last = $row;
+      $.each(cfg.map, function(child, parent) {
+        if (String(parent) !== String(id) || !rows[child]) return;
+        $last = rows[child].insertAfter($last);
+      });
+    });
+    $.each(cfg.map, function(child, parent) {
+      var $row = rows[child];
+      if (!$row || !rows[parent]) return;
+      $row.addClass('st-row');
+      var $a = $row.find('a[href$="/tasks/' + child + '/view"]').not('.preview').first();
+      $a.closest('td').addClass('st-title');
+      $a.before('<span class="st-arrow">&#8627;</span>');
+    });
+  }
+
+  function watch() {
+    if (!window.MutationObserver) return nest();
+    if (window.__stObserver) window.__stObserver.disconnect();
+    var timer;
+    window.__stObserver = new MutationObserver(function() {
+      clearTimeout(timer);
+      timer = setTimeout(function() {
+        if (!$('ul#ticket_tabs').length) { window.__stObserver.disconnect(); return; }
+        nest();
+      }, 100);
+    });
+    window.__stObserver.observe(document.body, {childList: true, subtree: true});
+    nest();
+  }
+
+  $(function() { setTimeout(watch, 0); });
+})(jQuery);
+</script>
diff --git a/include/plugins/sub-tasks/view.inc.php b/include/plugins/sub-tasks/view.inc.php
new file mode 100644
index 0000000..9188cf5
--- /dev/null
+++ b/include/plugins/sub-tasks/view.inc.php
@@ -0,0 +1,218 @@
+<?php
+// Rendered at the top of the staff task view (object.view signal).
+// Expects $json and $id from SubTasksPlugin::onTaskView().
+if (!defined('OSTSCPINC')) die('Access Denied');
+?>
+<span id="st-anchor-<?php echo (int) $id; ?>" style="display:none"></span>
+<style type="text/css">
+  .st-panel { margin: 12px 0 14px; }
+  .st-panel h4 { margin: 0 0 4px; font-size: 1em; overflow: hidden; line-height: 22px; }
+  .st-panel h4 .st-add { float: right; }
+  .st-panel table { width: 100%; border-collapse: collapse; }
+  .st-panel th, .st-panel td { text-align: left; padding: 4px 8px; border-bottom: 1px solid #e5e5e5; }
+  .st-panel .num { text-align: right; white-space: nowrap; }
+  .st-panel tr.st-total td { font-weight: bold; border-top: 2px solid #ccc; border-bottom: none; }
+  .st-panel tr.st-sub td.st-name { padding-left: 26px; }
+  .st-panel .st-empty { color: #888; margin: 2px 0 0; }
+  .st-arrow { color: #999; margin-right: 4px; }
+  .st-chip { display: inline-block; background: #eef4fa; border: 1px solid #cfe0f0; color: #2a5d8f;
+      border-radius: 9px; padding: 0 7px; font-size: 11px; line-height: 16px; margin-left: 6px; font-weight: normal; }
+  .st-done { color: #1a7f37; }
+  .st-of { margin: 8px 0 4px; padding: 6px 10px; background: #f4f8fc; border: 1px solid #dde8f3; border-radius: 3px; }
+  .st-of .faded { margin-left: 8px; }
+  .st-pick { padding: 4px 0 10px; }
+  .st-pick label { font-weight: bold; margin-right: 8px; }
+  .st-pick select { min-width: 340px; }
+  .st-pick .faded { margin-top: 5px; font-size: 12px; }
+  .st-move { margin-left: 10px; font-size: 12px; }
+  .st-move select { max-width: 360px; margin: 0 4px; }
+  .st-panel .st-movebar { margin-top: 4px; }
+</style>
+<script type="text/javascript">
+(function($) {
+  var cfg = <?php echo $json; ?>;
+
+  function esc(s) { return $('<div/>').text(s == null ? '' : String(s)).html(); }
+  function link(t) {
+    return '<a href="tasks.php?id=' + t.id + '">Task #' + esc(t.number) + '</a>';
+  }
+
+  // Reload the page the user is on (ticket Tasks tab or task view)
+  function go() {
+    var a = document.createElement('a'); a.href = cfg.returnUrl;
+    if (a.pathname + a.search === window.location.pathname + window.location.search) {
+      window.location.hash = a.hash;
+      window.location.reload();
+    }
+    else window.location.href = cfg.returnUrl;
+  }
+
+  /* ---- Move: make a sub-task / change parent / make top-level ---- */
+  function moveLinks() {
+    if (!cfg.moveUrl) return '';
+    if (cfg.parent)
+      return '<span class="st-move">' +
+        (cfg.moveTargets.length > 1 || (cfg.moveTargets.length && cfg.moveTargets[0].id !== cfg.parent.id)
+          ? '<a href="#" class="st-move-open no-pjax">Change parent</a> &middot; ' : '') +
+        '<a href="#" class="st-move-top no-pjax">Make top-level task</a></span>';
+    return cfg.moveTargets.length
+      ? '<span class="st-move"><a href="#" class="st-move-open no-pjax"><i class="icon-level-down"></i> Make this a sub-task of&hellip;</a></span>'
+      : '';
+  }
+
+  function saveParent(parentId) {
+    $.ajax({url: cfg.moveUrl, type: 'POST', data: {parent: parentId}})
+      .done(go)
+      .fail(function(xhr) {
+        $.sysAlert('Sub-tasks', xhr.responseText || 'Unable to move the task');
+      });
+  }
+
+  function openMover($link) {
+    var $wrap = $link.closest('.st-move');
+    var opts = '';
+    $.each(cfg.moveTargets, function(i, t) {
+      if (cfg.parent && t.id === cfg.parent.id) return;
+      opts += '<option value="' + t.id + '">' + esc(t.label) + '</option>';
+    });
+    $wrap.html('Parent: <select>' + opts + '</select><button type="button" class="button st-move-save">Move</button> ' +
+      '<a href="#" class="st-move-cancel no-pjax">Cancel</a>');
+    $wrap.data('html', moveLinks());
+  }
+
+  function scope() { return $('#st-anchor-' + cfg.id).parent(); }
+
+  function placePanel($scope, html) {
+    var $after = $scope.find('table.custom-data').last();
+    if (!$after.length) $after = $scope.find('table.ticket_info').first();
+    if (!$after.length) $after = $scope.find('.tixTitle').first();
+    $(html).insertAfter($after);
+  }
+
+  function renderParentLine($scope) {
+    var p = cfg.parent;
+    var line = '<div class="st-of"><i class="icon-sitemap"></i> Sub-task of ' + link(p) +
+      ' &mdash; ' + esc(p.title) + ' <span class="st-chip">' + esc(p.status) + '</span>' +
+      '<span class="faded">Time and cost posted here also count toward ' + 'Task #' + esc(p.number) + '.</span>' +
+      moveLinks() + '</div>';
+    $(line).insertAfter($scope.find('.tixTitle').first());
+    // Header: "Task #12 / Task #9 / Ticket #…" (or "All Tasks / Task #9 / Task #12" in a ticket)
+    var $rt = $scope.find('a#reload-task').first();
+    var crumb = link(p);
+    if (cfg.inTicket) $rt.before(crumb + '&nbsp;/&nbsp;');
+    else $rt.after('&nbsp;/&nbsp;' + crumb);
+  }
+
+  function renderPanel($scope) {
+    var kids = cfg.children || [];
+    if (!kids.length && !cfg.canAdd && !moveLinks()) return;
+    var done = 0;
+    $.each(kids, function(i, k) { if (!k.open) done++; });
+    var head = '<h4><i class="icon-sitemap"></i> Sub-tasks' +
+      (kids.length ? ' <span class="st-chip">' + done + ' of ' + kids.length + ' completed</span>' : '') +
+      (cfg.canAdd ? '<a class="st-add action-button no-pjax" href="#"><i class="icon-plus-sign"></i> Add Sub-task</a>' : '') +
+      '</h4>';
+    if (!kids.length)
+      return placePanel($scope, '<div class="st-panel">' + head + '<p class="st-empty">No sub-tasks yet.' +
+        moveLinks() + '</p></div>');
+
+    var tcols = cfg.hasTime ? '<th class="num">Time</th><th class="num">Cost</th>' : '';
+    var rows = '';
+    if (cfg.hasTime && cfg.own)
+      rows += '<tr><td>This task</td><td></td><td></td><td class="num">' + esc(cfg.own.time) +
+        '</td><td class="num">' + esc(cfg.own.cost) + '</td></tr>';
+    $.each(kids, function(i, k) {
+      rows += '<tr class="st-sub"><td class="st-name"><span class="st-arrow">&#8627;</span>' + link(k) +
+        ' &mdash; ' + esc(k.title) + '</td><td>' + (k.open ? '' : '<span class="st-done">&#10003;</span> ') +
+        esc(k.status) + '</td><td>' + (esc(k.assignee) || '&mdash;') + '</td>' +
+        (cfg.hasTime ? '<td class="num">' + esc(k.time) + '</td><td class="num">' + esc(k.cost) + '</td>' : '') +
+        '</tr>';
+    });
+    if (cfg.hasTime && cfg.total)
+      rows += '<tr class="st-total"><td>Total incl. sub-tasks</td><td></td><td></td><td class="num">' +
+        esc(cfg.total.time) + '</td><td class="num">' + esc(cfg.total.cost) + '</td></tr>';
+    placePanel($scope, '<div class="st-panel">' + head + '<table><thead><tr><th>Task</th><th>Status</th>' +
+      '<th>Assigned to</th>' + tcols + '</tr></thead><tbody>' + rows + '</tbody></table></div>');
+  }
+
+  /* ---- "Add Sub-task": osTicket's own New Task dialog + a parent picker ---- */
+  function openDialog() {
+    var pending = true, chosen = String(cfg.id);
+    var popup = $('.dialog#popup')[0];
+    var obs = window.MutationObserver ? new MutationObserver(function() {
+      if (!pending) return;
+      if (!$(popup).is(':visible')) { pending = false; obs.disconnect(); return; }
+      inject();
+    }) : null;
+
+    function inject() {
+      var $form = $('#popup form').filter(function() {
+        return $(this).attr('action') === cfg.formAction;
+      }).first();
+      if (!$form.length || $form.data('st-done')) return;
+      $form.data('st-done', 1);
+      $('#popup h3.drag-handle').first().text('Task #' + cfg.number + ': Add Sub-task');
+      var opts = '';
+      $.each(cfg.parents, function(i, p) {
+        opts += '<option value="' + p.id + '"' + (String(p.id) === chosen ? ' selected' : '') + '>' +
+          esc(p.label) + '</option>';
+      });
+      opts += '<option value=""' + (chosen === '' ? ' selected' : '') + '>(none &mdash; a regular task)</option>';
+      var $pick = $('<div class="st-pick"><label>Parent task:</label><select name="st_parent">' + opts +
+        '</select><div class="faded">The sub-task is a normal task' +
+        (cfg.inTicket || cfg.formAction.indexOf('#tickets/') === 0 ? ' on the same ticket' : '') +
+        '; its time and cost count toward the parent.</div></div>');
+      $pick.find('select').on('change', function() { chosen = $(this).val(); });
+      $form.prepend($pick);
+      if (cfg.deptId) {
+        var $dept = $form.find('label').filter(function() {
+          return /department/i.test($(this).text());
+        }).first().closest('fieldset, td, div').find('select').first();
+        if ($dept.length && !$dept.val() && $dept.find('option[value="' + cfg.deptId + '"]').length)
+          $dept.val(String(cfg.deptId)).trigger('change');
+      }
+    }
+
+    $.dialog(cfg.addUrl, [201], function() {
+      pending = false;
+      if (obs) obs.disconnect();
+      go();
+      return false;
+    }, {size: 'large', onshow: inject});
+    if (obs) obs.observe(popup, {attributes: true, attributeFilter: ['style'], childList: true, subtree: true});
+  }
+
+  function init() {
+    var $scope = scope();
+    if (!$scope.length || $scope.data('st-done')) return;
+    $scope.data('st-done', 1);
+    if (cfg.parent) renderParentLine($scope);
+    else renderPanel($scope);
+    $scope.off('click.st').on('click.st', 'a.st-add', function(e) {
+      e.preventDefault();
+      openDialog();
+      return false;
+    }).on('click.st', 'a.st-move-open', function(e) {
+      e.preventDefault();
+      openMover($(this));
+      return false;
+    }).on('click.st', 'a.st-move-cancel', function(e) {
+      e.preventDefault();
+      var $w = $(this).closest('.st-move');
+      $w.replaceWith($w.data('html'));
+      return false;
+    }).on('click.st', 'button.st-move-save', function(e) {
+      e.preventDefault();
+      saveParent($(this).closest('.st-move').find('select').val());
+      return false;
+    }).on('click.st', 'a.st-move-top', function(e) {
+      e.preventDefault();
+      if (confirm('Make Task #' + cfg.number + ' a top-level task again?')) saveParent('');
+      return false;
+    });
+  }
+
+  // Normal page load, PJAX navigation and tasks loaded by AJAX in a ticket
+  $(function() { setTimeout(init, 0); });
+})(jQuery);
+</script>
