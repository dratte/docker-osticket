diff --git a/include/plugins/time-tracking/timetracking.php b/include/plugins/time-tracking/timetracking.php
new file mode 100644
index 0000000..59e015e
--- /dev/null
+++ b/include/plugins/time-tracking/timetracking.php
@@ -0,0 +1,503 @@
+<?php
+/*********************************************************************
+ * Time & Cost Tracking plugin for osTicket 1.17 / 1.18
+ *
+ * - Adds "Time" and "Cost" inputs to the staff Post Reply / Post
+ *   Internal Note forms on tickets, and Post Update / Post Internal
+ *   Note on tasks (standalone or opened inside a ticket).
+ * - Every post with a value logs a row in %TABLE_PREFIX%time_cost_entry.
+ * - Ticket Time / Cost fields = ticket's own entries + all of its tasks.
+ *   Task Time / Cost fields = that task's own entries.
+ * - Each thread entry with logged time/cost shows a small badge.
+ *
+ * Totals are always recomputed from the log, so concurrent posts can't
+ * drift. Any value already in a ticket's or task's Time/Cost field the
+ * first time an entry is logged on it is imported as an "opening" row.
+ *********************************************************************/
+
+require_once INCLUDE_DIR . 'class.plugin.php';
+require_once INCLUDE_DIR . 'class.signal.php';
+require_once __DIR__ . '/config.php';
+require_once __DIR__ . '/reports.php';
+require_once __DIR__ . '/agentreport.php';
+
+class TimeTrackingPlugin extends Plugin {
+    var $config_class = 'TimeTrackingConfig';
+
+    // Instance settings captured at bootstrap (PluginManager clears the
+    // side-loaded config right after bootstrap()).
+    static $opts = null;
+    static $handled = false;
+    static $posted = array();   // "T:12" => true when a post succeeded this request
+    static $schemaOk = false;
+
+    function isMultiInstance() {
+        return false;
+    }
+
+    function bootstrap() {
+        $c = $this->getConfig();
+        $fmt = $c->get('time_format');
+        if (is_array($fmt))
+            $fmt = key($fmt);
+
+        $round = $c->get('timer_round');
+        if (is_array($round))
+            $round = key($round);
+        $round = (int) $round;
+        if (!in_array($round, array(1, 6, 15, 30, 60)))
+            $round = 6;
+
+        $ws = $c->get('week_start');
+        if (is_array($ws))
+            $ws = key($ws);
+
+        self::$opts = array(
+            'time_field' => mb_strtolower(trim($c->get('time_field') ?: 'time')),
+            'cost_field' => mb_strtolower(trim($c->get('cost_field') ?: 'cost')),
+            'task_time_field' => mb_strtolower(trim($c->get('task_time_field') ?: 'time')),
+            'task_cost_field' => mb_strtolower(trim($c->get('task_cost_field') ?: 'cost')),
+            'time_format' => $fmt === 'hm' ? 'hm' : 'decimal',
+            'currency' => (string) $c->get('currency', '$'),
+            'timer' => (bool) $c->get('timer', true),
+            'reports' => (bool) $c->get('reports', true),
+            'category_field' => mb_strtolower(trim($c->get('category_field') ?: 'category')),
+            'timer_round' => $round,
+            'week_start' => $ws === 'sun' ? 'sun' : 'mon',
+        );
+
+        Signal::connect('threadentry.created', array(__CLASS__, 'onEntryCreated'));
+        Signal::connect('object.view', array(__CLASS__, 'onObjectView'), 'Ticket');
+        Signal::connect('object.view', array(__CLASS__, 'onObjectView'), 'Task');
+        Signal::connect('model.deleted', array(__CLASS__, 'onObjectDeleted'), 'Task');
+        Signal::connect('model.deleted', array(__CLASS__, 'onObjectDeleted'), 'Ticket');
+        Signal::connect('ajax.scp', function($dispatcher) {
+            $dispatcher->append(url_get('^/timetracking/ticket/(?P<id>\d+)/summary$',
+                function($id) { TimeTrackingPlugin::ajaxSummary($id); }));
+        });
+    }
+
+    /* ---------------------------------------------------------------
+     * Parsing / formatting
+     * ------------------------------------------------------------- */
+
+    /**
+     * Accepts "1.5", "1,5", "1:30", "1h30m", "1h 30m", "90m", "2h", "-0.25".
+     * Returns signed minutes (int), null for empty input, false if invalid.
+     */
+    static function parseTime($input) {
+        $s = strtolower(trim((string) $input));
+        if ($s === '')
+            return null;
+        $sign = 1;
+        if ($s[0] === '-') { $sign = -1; $s = ltrim(substr($s, 1)); }
+        elseif ($s[0] === '+') { $s = ltrim(substr($s, 1)); }
+        $s = str_replace(',', '.', $s);
+
+        if (preg_match('/^(\d+):([0-5]?\d)$/', $s, $m))
+            $min = $m[1] * 60 + $m[2];
+        elseif (preg_match('/^(?:(\d+(?:\.\d+)?)\s*h(?:rs?|ours?)?)?\s*(?:(\d+)\s*m(?:in(?:utes?)?)?)?$/', $s, $m)
+                && (@$m[1] !== '' || @$m[2] !== '') && $s !== '')
+            $min = round(((float) @$m[1]) * 60) + (int) @$m[2];
+        elseif (preg_match('/^\d+(?:\.\d+)?$/', $s))
+            $min = round(((float) $s) * 60);   // bare number = hours
+        else
+            return false;
+
+        return $sign * (int) $min;
+    }
+
+    /**
+     * Accepts "75", "75.50", "$1,250.00", "-20". Returns signed float
+     * rounded to cents, null for empty input, false if invalid.
+     */
+    static function parseCost($input) {
+        $s = trim((string) $input);
+        if ($s === '')
+            return null;
+        $s = preg_replace('/[\s$€£¥,]/u', '', $s);
+        if (!preg_match('/^[-+]?\d+(?:\.\d{1,2})?$/', $s))
+            return false;
+        return round((float) $s, 2);
+    }
+
+    static function formatTime($minutes) {
+        $minutes = (int) $minutes;
+        if (self::$opts['time_format'] === 'hm') {
+            $sign = $minutes < 0 ? '-' : '';
+            $minutes = abs($minutes);
+            return sprintf('%s%d:%02d', $sign, intdiv($minutes, 60), $minutes % 60);
+        }
+        return sprintf('%.2f', $minutes / 60);
+    }
+
+    static function formatCost($cost) {
+        return sprintf('%.2f', $cost);
+    }
+
+    /* ---------------------------------------------------------------
+     * Storage
+     *
+     * object_type/object_id: what the time was logged on ('T' ticket or
+     * 'A' task). ticket_id: the ticket the row rolls up into (the ticket
+     * itself, the task's parent ticket, or 0 for a standalone task).
+     * ------------------------------------------------------------- */
+
+    static function table() {
+        return TABLE_PREFIX . 'time_cost_entry';
+    }
+
+    static function ensureSchema() {
+        if (self::$schemaOk)
+            return true;
+        $sql = 'CREATE TABLE IF NOT EXISTS `' . self::table() . '` (
+              `id` int(11) unsigned NOT NULL auto_increment,
+              `object_type` char(1) NOT NULL default \'T\',
+              `object_id` int(11) unsigned NOT NULL,
+              `ticket_id` int(11) unsigned NOT NULL default 0,
+              `thread_entry_id` int(11) unsigned NOT NULL default 0,
+              `staff_id` int(11) unsigned NOT NULL default 0,
+              `kind` varchar(16) NOT NULL default \'entry\',
+              `minutes` int(11) NOT NULL default 0,
+              `cost` decimal(12,2) NOT NULL default 0,
+              `created` datetime NOT NULL,
+              PRIMARY KEY (`id`),
+              KEY `object` (`object_type`, `object_id`),
+              KEY `ticket_id` (`ticket_id`),
+              KEY `thread_entry_id` (`thread_entry_id`)
+            ) DEFAULT CHARSET=utf8';
+        return self::$schemaOk = (bool) db_query($sql);
+    }
+
+    static function insertRow($type, $objId, $ticketId, $entryId, $staffId,
+            $kind, $minutes, $cost) {
+        return db_query(sprintf(
+            'INSERT INTO `%s` (object_type, object_id, ticket_id, thread_entry_id,
+                staff_id, kind, minutes, cost, created)
+             VALUES (%s, %d, %d, %d, %d, %s, %d, %s, NOW())',
+            self::table(), db_input($type), $objId, $ticketId, $entryId,
+            $staffId, db_input($kind), $minutes, db_input(sprintf('%.2f', $cost))));
+    }
+
+    static function objectHasRows($type, $objId) {
+        $res = db_query(sprintf(
+            'SELECT 1 FROM `%s` WHERE object_type=%s AND object_id=%d LIMIT 1',
+            self::table(), db_input($type), $objId));
+        return $res && db_num_rows($res) > 0;
+    }
+
+    /** Ticket: own rows + rows of its tasks. Task: own rows only. */
+    static function totals($type, $objId) {
+        $where = $type === 'T'
+            ? sprintf('ticket_id=%d', $objId)
+            : sprintf("object_type='A' AND object_id=%d", $objId);
+        $res = db_query(sprintf(
+            'SELECT COALESCE(SUM(minutes),0) AS minutes, COALESCE(SUM(cost),0) AS cost
+             FROM `%s` WHERE %s', self::table(), $where));
+        $row = $res ? db_fetch_array($res) : null;
+        return array((int) @$row['minutes'], (float) @$row['cost']);
+    }
+
+    /* ---------------------------------------------------------------
+     * Custom-field access (ticket or task forms)
+     * ------------------------------------------------------------- */
+
+    static function fieldNames($type) {
+        $o = self::$opts;
+        return $type === 'A'
+            ? array($o['task_time_field'], $o['task_cost_field'])
+            : array($o['time_field'], $o['cost_field']);
+    }
+
+    /** Find (or create) the answer object for a field by variable name. */
+    static function getAnswer($type, $objId, $name) {
+        foreach (DynamicFormEntry::forObject($objId, $type) as $entry) {
+            if ($a = $entry->getAnswer($name))
+                return $a;
+            // Field is on this form but has never been answered
+            foreach ($entry->getFields() as $f) {
+                if (mb_strtolower($f->get('name')) == $name) {
+                    $entry->addMissingFields();
+                    return $entry->getAnswer($f->get('name'));
+                }
+            }
+        }
+        return null;
+    }
+
+    static function setAnswer($type, $objId, $name, $value) {
+        if (!($a = self::getAnswer($type, $objId, $name)))
+            return false;
+        if ((string) $a->get('value') === (string) $value)
+            return true;
+        $a->setValue($value);
+        return $a->save();   // fires model.updated -> refreshes __cdata tables
+    }
+
+    /**
+     * Time / cost logged on a ticket's tasks: array(minutes, cost).
+     * With $beforeId, only rows created before that row id.
+     */
+    static function taskRowsTotal($ticketId, $beforeId=0) {
+        $res = db_query(sprintf(
+            "SELECT COALESCE(SUM(minutes),0) AS m, COALESCE(SUM(cost),0) AS c FROM `%s`
+             WHERE ticket_id=%d AND object_type='A'%s",
+            self::table(), $ticketId, $beforeId ? sprintf(' AND id < %d', $beforeId) : ''));
+        $row = $res ? db_fetch_array($res) : null;
+        return array((int) @$row['m'], (float) @$row['c']);
+    }
+
+    /**
+     * First row for an object: import any hand-entered field values.
+     *
+     * A ticket's Time / Cost fields hold the ticket's total INCLUDING its
+     * tasks, so time already logged on its tasks is subtracted: only the
+     * remainder belongs to the ticket itself.
+     */
+    static function seedOpening($type, $objId, $ticketId) {
+        if (self::objectHasRows($type, $objId))
+            return;
+        list($tf, $cf) = self::fieldNames($type);
+        $min = ($a = self::getAnswer($type, $objId, $tf))
+            ? self::parseTime($a->get('value')) : null;
+        $cost = ($a = self::getAnswer($type, $objId, $cf))
+            ? self::parseCost($a->get('value')) : null;
+        if ($type === 'T') {
+            list($tm, $tc) = self::taskRowsTotal($objId);
+            $min = max(0, (int) $min - $tm);
+            $cost = max(0, round((float) $cost - $tc, 2));
+        }
+        if ($min || $cost)
+            // 'opening-net': a ticket opening that already leaves out its
+            // tasks' time (see TimeReports::doubleCounts())
+            self::insertRow($type, $objId, $ticketId, 0, 0, $type === 'T' ? 'opening-net' : 'opening',
+                (int) $min, (float) $cost);
+    }
+
+    static function updateTotals($type, $objId) {
+        list($tf, $cf) = self::fieldNames($type);
+        list($min, $cost) = self::totals($type, $objId);
+        self::setAnswer($type, $objId, $tf, self::formatTime($min));
+        self::setAnswer($type, $objId, $cf, self::formatCost($cost));
+    }
+
+    /** Parent ticket id of a task (0 if standalone). */
+    static function taskTicketId($task) {
+        return ($task->object_type === 'T') ? (int) $task->object_id : 0;
+    }
+
+    /* ---------------------------------------------------------------
+     * Signal handlers
+     * ------------------------------------------------------------- */
+
+    static function onEntryCreated($entry) {
+        global $thisstaff;
+
+        if (self::$handled || !self::$opts || !$thisstaff
+                || !defined('OSTSCPINC') || $_SERVER['REQUEST_METHOD'] !== 'POST')
+            return;
+        if (!($thread = $entry->getThread()) || !($obj = $thread->getObject()))
+            return;
+
+        // Only the staff Post Reply / Update and Post Internal Note actions
+        $type = $thread->getObjectType();
+        $actions = array(
+            'T' => array('reply' => 'R', 'postnote' => 'N'),
+            'A' => array('postreply' => 'R', 'postnote' => 'N'),
+        );
+        $action = @$_POST['a'];
+        if (!isset($actions[$type][$action]) || $entry->type !== $actions[$type][$action])
+            return;
+        // The post went through: don't re-fill the inputs on the redisplayed form
+        self::$posted[$type . ':' . $obj->getId()] = true;
+
+        $minutes = self::parseTime(@$_POST['tt_time']);
+        $cost = self::parseCost(@$_POST['tt_cost']);
+        if ($minutes === false || $cost === false) {
+            global $ost;
+            $ost->logWarning('Time & Cost Tracking',
+                sprintf('Ignored invalid time/cost (%s / %s) on %s #%s',
+                    @$_POST['tt_time'], @$_POST['tt_cost'],
+                    $type === 'A' ? 'task' : 'ticket', $obj->getNumber()), false);
+            $minutes = $minutes === false ? null : $minutes;
+            $cost = $cost === false ? null : $cost;
+        }
+        if (!$minutes && !$cost)
+            return;
+
+        self::$handled = true;
+        if (!self::ensureSchema())
+            return;
+
+        $objId = $obj->getId();
+        $ticketId = $type === 'T' ? $objId : self::taskTicketId($obj);
+
+        // Import hand-entered values before the first logged row, for the
+        // object itself and (for a task) its parent ticket.
+        self::seedOpening($type, $objId, $ticketId);
+        if ($type === 'A' && $ticketId)
+            self::seedOpening('T', $ticketId, $ticketId);
+
+        self::insertRow($type, $objId, $ticketId, $entry->getId(),
+            $thisstaff->getId(), 'entry', (int) $minutes, (float) $cost);
+
+        self::updateTotals($type, $objId);
+        if ($type === 'A' && $ticketId)
+            self::updateTotals('T', $ticketId);
+    }
+
+    /** Remove a deleted task's rows and refresh its parent ticket. */
+    static function onObjectDeleted($obj, &$data=null) {
+        if (!self::$opts || !self::ensureSchema())
+            return;
+        if ($obj instanceof Task) {
+            $id = (int) $obj->getId();
+            db_query(sprintf("DELETE FROM `%s` WHERE object_type='A' AND object_id=%d",
+                self::table(), $id));
+            if ($tid = self::taskTicketId($obj))
+                self::updateTotals('T', $tid);
+        } elseif ($obj instanceof Ticket) {
+            // Tasks of a deleted ticket are deleted separately; drop the
+            // ticket's own rows and detach anything still pointing at it.
+            $id = (int) $obj->getId();
+            db_query(sprintf("DELETE FROM `%s` WHERE object_type='T' AND object_id=%d",
+                self::table(), $id));
+            db_query(sprintf('UPDATE `%s` SET ticket_id=0 WHERE ticket_id=%d',
+                self::table(), $id));
+        }
+    }
+
+    /* ---------------------------------------------------------------
+     * Ticket breakdown (ticket's own time + each task)
+     * ------------------------------------------------------------- */
+
+    static function fmtPair($min, $cost) {
+        $c = (float) $cost;
+        return array(
+            'time' => self::formatTime($min)
+                . (self::$opts['time_format'] === 'decimal' ? ' h' : ''),
+            'cost' => ($c < 0 ? '-' : '') . self::$opts['currency'] . self::formatCost(abs($c)),
+        );
+    }
+
+    static function summary($ticket) {
+        $tid = (int) $ticket->getId();
+        $own = array(0, 0.0);
+        $perTask = array();
+        if (self::ensureSchema()) {
+            $res = db_query(sprintf(
+                "SELECT object_type, object_id, SUM(minutes) m, SUM(cost) c
+                 FROM `%s` WHERE ticket_id=%d GROUP BY object_type, object_id",
+                self::table(), $tid));
+            while ($res && ($r = db_fetch_array($res))) {
+                if ($r['object_type'] === 'T')
+                    $own = array((int) $r['m'], (float) $r['c']);
+                else
+                    $perTask[(int) $r['object_id']] = array((int) $r['m'], (float) $r['c']);
+            }
+        }
+        $tasks = array();
+        $sumMin = $own[0]; $sumCost = $own[1];
+        foreach (Task::objects()->filter(array(
+                'object_id' => $tid, 'object_type' => ObjectModel::OBJECT_TYPE_TICKET))
+                ->order_by('id') as $task) {
+            list($m, $c) = isset($perTask[$task->getId()]) ? $perTask[$task->getId()] : array(0, 0.0);
+            $sumMin += $m; $sumCost += $c;
+            $tasks[] = array_merge(array(
+                'id' => (int) $task->getId(),
+                'number' => $task->getNumber(),
+                'title' => (string) $task->getTitle(),
+                'status' => (string) $task->getStatus(),
+                'open' => (bool) $task->isOpen(),
+                'minutes' => $m, 'amount' => $c, 'parent' => 0, 'subs' => 0,
+            ), self::fmtPair($m, $c));
+        }
+        // Sub-tasks plugin: list each sub-task under its parent. Every row
+        // is still that task's own time, so the total is unchanged.
+        if ($tasks && class_exists('SubTasksPlugin', false) && SubTasksPlugin::active()) {
+            $byId = array();
+            foreach ($tasks as $t) $byId[$t['id']] = $t;
+            $ordered = array();
+            foreach (SubTasksPlugin::order(array_keys($byId)) as $id => $parent) {
+                $t = $byId[$id];
+                $t['parent'] = $parent;
+                if ($parent) $ordered[$parent]['subs']++;
+                $ordered[$id] = $t;
+            }
+            $tasks = array_values($ordered);
+        }
+        return array(
+            'ticket' => array_merge(array('minutes' => $own[0], 'amount' => $own[1]),
+                self::fmtPair($own[0], $own[1])),
+            'tasks' => $tasks,
+            'total' => array_merge(array('minutes' => $sumMin, 'amount' => $sumCost),
+                self::fmtPair($sumMin, $sumCost)),
+        );
+    }
+
+    static function ajaxSummary($id) {
+        global $thisstaff;
+        if (!$thisstaff)
+            Http::response(403, 'Login required');
+        if (!($ticket = Ticket::lookup((int) $id)) || !$ticket->checkStaffPerm($thisstaff))
+            Http::response(404, 'No such ticket');
+        Http::response(200, JsonDataEncoder::encode(self::summary($ticket)),
+            'application/json');
+    }
+
+    static function onObjectView($obj, &$data=null) {
+        global $thisstaff;
+
+        if (!self::$opts || !$thisstaff || !defined('OSTSCPINC'))
+            return;
+
+        $type = $obj instanceof Task ? 'A' : 'T';
+
+        // Per-entry badges
+        $badges = array();
+        if (self::ensureSchema()) {
+            $res = db_query(sprintf(
+                'SELECT thread_entry_id, SUM(minutes) AS minutes, SUM(cost) AS cost
+                 FROM `%s` WHERE object_type=%s AND object_id=%d AND thread_entry_id>0
+                 GROUP BY thread_entry_id',
+                self::table(), db_input($type), $obj->getId()));
+            while ($res && ($r = db_fetch_array($res))) {
+                $parts = array();
+                if ((int) $r['minutes'])
+                    $parts[] = self::formatTime($r['minutes'])
+                        . (self::$opts['time_format'] === 'decimal' ? ' h' : '');
+                if ($c = (float) $r['cost'])
+                    $parts[] = ($c < 0 ? '-' : '') . self::$opts['currency']
+                        . self::formatCost(abs($c));
+                if ($parts)
+                    $badges[(int) $r['thread_entry_id']] = implode(' · ', $parts);
+            }
+        }
+
+        // Re-fill inputs if the post failed validation and the form is
+        // redisplayed (only for the object that was posted to).
+        $posted = isset($_POST['id']) && (int) $_POST['id'] === (int) $obj->getId()
+            && empty(self::$posted[$type . ':' . $obj->getId()]);
+        $prefill = array(
+            'time' => $posted ? (string) @$_POST['tt_time'] : '',
+            'cost' => $posted ? (string) @$_POST['tt_cost'] : '',
+            'action' => $posted ? (string) @$_POST['a'] : '',
+        );
+
+        $cfg = array(
+            'scope' => $type,
+            'objId' => (int) $obj->getId(),
+            'ticketId' => $type === 'T' ? (int) $obj->getId() : null,
+            'summaryUrl' => $type === 'T'
+                ? sprintf('ajax.php/timetracking/ticket/%d/summary', $obj->getId()) : null,
+            'badges' => (object) $badges,
+            'prefill' => $prefill,
+            'unit' => self::$opts['time_format'] === 'hm' ? 'h:mm' : 'hours',
+            'currency' => self::$opts['currency'],
+            'timer' => self::$opts['timer'],
+            'roundMin' => self::$opts['timer_round'],
+        );
+        $json = json_encode($cfg, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
+        include __DIR__ . '/view.inc.php';
+    }
+}
diff --git a/include/plugins/time-tracking/view.inc.php b/include/plugins/time-tracking/view.inc.php
new file mode 100644
index 0000000..1facff7
--- /dev/null
+++ b/include/plugins/time-tracking/view.inc.php
@@ -0,0 +1,300 @@
+<?php
+// Rendered at the top of the staff ticket view (object.view signal).
+// Expects $json (encoded config) from TimeTrackingPlugin::onTicketView().
+if (!defined('OSTSCPINC')) die('Access Denied');
+?>
+<style type="text/css">
+  .tt-row input.tt-time { width: 7em; }
+  .tt-row input.tt-cost { width: 8em; }
+  .tt-row .tt-hint { margin-left: 6px; }
+  .tt-row input.tt-invalid { border-color: #a00; background: #fff0f0; }
+  .tt-badge { margin-right: 4px; }
+  .tt-row input.tt-time.tt-running { color: #1a7f37; font-family: monospace; }
+  .tt-row input.tt-time.tt-paused { color: #b36b00; font-family: monospace; }
+  .tt-row a.tt-tbtn { margin-left: 7px; color: #555; text-decoration: none; }
+  .tt-row a.tt-tbtn:hover { color: #000; }
+  #tt-summary { margin: 10px 0 14px; }
+  #tt-summary h4 { margin: 0 0 4px; font-size: 1em; }
+  #tt-summary table { width: 100%; border-collapse: collapse; }
+  #tt-summary th, #tt-summary td { text-align: left; padding: 3px 8px; border-bottom: 1px solid #e5e5e5; }
+  #tt-summary .num, .tt-col { text-align: right; white-space: nowrap; }
+  #tt-summary tr.tt-sub td:first-child { padding-left: 26px; }
+  #tt-summary tr.tt-sub td { color: #555; }
+  #tt-summary .tt-arrow { color: #999; margin-right: 4px; }
+  #tt-summary .tt-chip { display: inline-block; background: #eef4fa; border: 1px solid #cfe0f0; color: #2a5d8f;
+      border-radius: 9px; padding: 0 7px; font-size: 11px; line-height: 16px; margin-left: 6px; }
+  #tt-summary tr.tt-total td { font-weight: bold; border-top: 2px solid #ccc; border-bottom: none; }
+</style>
+<script type="text/javascript">
+(function($) {
+  var cfg = <?php echo $json; ?>;
+
+  var timeRe = /^[-+]?\s*(\d+([.,]\d+)?|\d+:[0-5]?\d|(\d+([.,]\d+)?\s*h(rs?|ours?)?)?\s*(\d+\s*m(in(utes?)?)?)?)$/i;
+  var costRe = /^[-+]?[\s$\u20ac\u00a3\u00a5]*[\d,]*\d(\.\d{1,2})?$/;
+
+  function esc(s) { return $('<div/>').text(s).html(); }
+
+  /* ---- Count-up timer (one per ticket / task view) ---- */
+  var T = {start: Date.now(), accum: 0, running: true, iv: null};
+
+  function elapsedSec() {
+    return T.accum + (T.running ? (Date.now() - T.start) / 1000 : 0);
+  }
+  function clock(sec) {
+    sec = Math.floor(sec);
+    var h = Math.floor(sec / 3600), m = Math.floor(sec % 3600 / 60), x = sec % 60;
+    return h + ':' + (m < 10 ? '0' : '') + m + ':' + (x < 10 ? '0' : '') + x;
+  }
+  // Round elapsed time UP to the configured step; '' when nothing elapsed
+  function roundedValue(sec) {
+    if (sec <= 0) return '';
+    var step = cfg.roundMin || 1;
+    var min = Math.ceil(sec / 60 / step - 1e-9) * step;
+    if (min <= 0) min = step;
+    if (cfg.unit === 'hours')
+      return String(parseFloat((min / 60).toFixed(2)));
+    return Math.floor(min / 60) + ':' + (min % 60 < 10 ? '0' : '') + (min % 60);
+  }
+  function timedInputs() {
+    return $('input.tt-time').filter(function() {
+      return $(this).data('tt-timer') === cfg.scope + ':' + cfg.objId;
+    });
+  }
+  function tick() {
+    var $in = timedInputs();
+    if (!$in.length) {        // left this page: stop
+      if (T.iv && !$('.tt-row[data-tt-key="' + cfg.scope + ':' + cfg.objId + '"]').length) {
+        clearInterval(T.iv); T.iv = null;
+      }
+      return;
+    }
+    var txt = clock(elapsedSec());
+    $in.val(txt).toggleClass('tt-running', T.running).toggleClass('tt-paused', !T.running);
+    $('.tt-row[data-tt-key="' + cfg.scope + ':' + cfg.objId + '"] a.tt-pause i')
+      .attr('class', T.running ? 'icon-pause' : 'icon-play');
+  }
+  function attachTimer($in) {
+    $in.data('tt-timer', cfg.scope + ':' + cfg.objId)
+       .attr('title', 'Timer running. Click to type a time instead.');
+    if (!T.iv) T.iv = setInterval(tick, 1000);
+    tick();
+  }
+  // Stop the timer driving this box (agent types a time, or the form posts)
+  function detachTimer($in, value) {
+    if (!$in.data('tt-timer')) return;
+    $in.removeData('tt-timer').removeClass('tt-running tt-paused').removeAttr('title');
+    $in.val(value);
+  }
+
+  function row(single) {
+    var unit = cfg.unit === 'hours' ? 'hours' : 'h:mm';
+    var hint = cfg.scope === 'A'
+      ? 'Added to the task totals and the parent ticket. '
+      : 'Added to the ticket totals. ';
+    var label = '<label><strong>Time / Cost:</strong></label>';
+    function roundLabel() {
+      var m = cfg.roundMin || 1;
+      return m === 1 ? 'the next minute' : m === 60 ? 'the next hour'
+        : 'the next ' + parseFloat((m / 60).toFixed(2)) + ' h';
+    }
+    var inputs =
+        '<input type="text" class="tt-time" name="tt_time" autocomplete="off" ' +
+          'placeholder="' + (unit === 'hours' ? '1.5' : '1:30') + '"> ' +
+        (cfg.timer
+          ? '<a href="#" class="tt-tbtn tt-pause no-pjax" title="Pause / resume timer"><i class="icon-pause"></i></a>' +
+            '<a href="#" class="tt-tbtn tt-reset no-pjax" title="Restart timer from zero"><i class="icon-refresh"></i></a> '
+          : '') +
+        '<span class="faded">' + unit + '</span>' +
+        '&nbsp;&nbsp;&nbsp;' + esc(cfg.currency) +
+        '<input type="text" class="tt-cost" name="tt_cost" autocomplete="off" placeholder="0.00">' +
+        '<span class="faded tt-hint">' + hint +
+          (cfg.timer ? 'The timer is rounded up to ' + roundLabel() + ' when you post; click the box to type a time instead. '
+                     : 'Accepts 1.5, 1:30, 1h 30m or 45m; use a negative value to correct.') + '</span>' +
+        '<div class="error tt-error" style="display:none">Invalid time or cost ' +
+          '&mdash; correct it before posting.</div>';
+    // Ticket forms use a label column; task forms are a single column
+    return $(single
+      ? '<tr class="tt-row"><td><div>' + label + '&nbsp; ' + inputs + '</div></td></tr>'
+      : '<tr class="tt-row"><td width="120">' + label + '</td><td>' + inputs + '</td></tr>');
+  }
+
+  function addTo(formSel, statusSel, action) {
+    var $form = $(formSel);
+    if (!$form.length || $form.find('.tt-row').length) return;
+    var $status = $form.find(statusSel).first().closest('tr');
+    var $r = row($status.length && $status.children('td').length === 1);
+    if ($status.length) $r.insertBefore($status);
+    else $form.find('table').last().append($r);
+
+    $r.attr('data-tt-key', cfg.scope + ':' + cfg.objId);
+    var $time = $r.find('.tt-time');
+    var prefilled = cfg.prefill.action === action
+      && (cfg.prefill.time !== '' || cfg.prefill.cost !== '');
+    if (prefilled) {
+      $time.val(cfg.prefill.time);
+      $r.find('.tt-cost').val(cfg.prefill.cost);
+    }
+    if (cfg.timer) {
+      if (!prefilled) attachTimer($time);
+      // Clicking into the box hands it over to the agent (rounded value
+      // pre-selected, so typing replaces it)
+      $time.on('focus.tt', function() {
+        if ($(this).data('tt-timer')) {
+          detachTimer($(this), roundedValue(elapsedSec()));
+          this.select();
+        }
+      });
+      $r.find('a.tt-pause').on('click', function(e) {
+        e.preventDefault();
+        if (T.running) { T.accum = elapsedSec(); T.running = false; }
+        else { T.start = Date.now(); T.running = true; }
+        if (!$time.data('tt-timer')) attachTimer($time);
+        tick();
+      });
+      $r.find('a.tt-reset').on('click', function(e) {
+        e.preventDefault();
+        T.accum = 0; T.start = Date.now();
+        $('.tt-row[data-tt-key="' + cfg.scope + ':' + cfg.objId + '"] input.tt-time').each(function() {
+          attachTimer($(this));
+        });
+        tick();
+      });
+    }
+
+    function validate() {
+      var ok = true;
+      $r.find('.tt-time, .tt-cost').each(function() {
+        if ($(this).data('tt-timer')) return;     // live timer, converted on post
+        var v = $.trim(this.value), re = $(this).hasClass('tt-time') ? timeRe : costRe;
+        var bad = v !== '' && !re.test(v);
+        $(this).toggleClass('tt-invalid', bad);
+        if (bad) ok = false;
+      });
+      $r.find('.tt-error').toggle(!ok);
+      return ok;
+    }
+    $r.find('.tt-time, .tt-cost').on('change blur', validate);
+
+    // osTicket binds its own submit handler (overlay + disabled buttons)
+    // when the page loads, so validate on the button click, which fires
+    // first -- including implicit submits from pressing Enter.
+    $form.on('click.tt', 'input[type=submit], button[type=submit]', function(e) {
+      // Timer still running in this box: post the rounded-up time
+      if ($time.data('tt-timer'))
+        detachTimer($time, roundedValue(elapsedSec()));
+      if (!validate()) {
+        e.preventDefault();
+        e.stopImmediatePropagation();
+        $r.find('.tt-invalid').first().focus();
+        return false;
+      }
+    });
+  }
+
+  function badges() {
+    $.each(cfg.badges, function(id, text) {
+      var $h = $('#thread-entry-' + id + ' .header .textra').first();
+      if ($h.length && !$h.find('.tt-badge').length)
+        $h.prepend('<span class="label label-bare tt-badge" title="Time / Cost logged">' +
+          '<i class="icon-time"></i> ' + esc(text) + '</span>');
+    });
+  }
+
+  /* ---- Ticket: breakdown panel + Time/Cost columns on the Tasks tab ---- */
+  var summary = null, loading = false;
+
+  function renderPanel() {
+    $('#tt-summary').remove();
+    if (!summary) return;
+    var any = summary.total.minutes || summary.total.amount;
+    $.each(summary.tasks, function(i, t) { if (t.minutes || t.amount) any = true; });
+    if (!any) return;
+    var rows = '<tr><td>' + 'This ticket' + '</td><td></td>' +
+      '<td class="num">' + esc(summary.ticket.time) + '</td>' +
+      '<td class="num">' + esc(summary.ticket.cost) + '</td></tr>';
+    $.each(summary.tasks, function(i, t) {
+      rows += '<tr' + (t.parent ? ' class="tt-sub"' : '') + '><td>' +
+        (t.parent ? '<span class="tt-arrow">&#8627;</span>' : '') +
+        '<a href="tasks.php?id=' + t.id + '">Task #' + esc(t.number) + '</a> &mdash; ' +
+        esc(t.title) + (t.subs ? ' <span class="tt-chip">' + t.subs + ' sub-task' + (t.subs > 1 ? 's' : '') + '</span>' : '') +
+        '</td><td>' + esc(t.status) + '</td>' +
+        '<td class="num">' + esc(t.time) + '</td><td class="num">' + esc(t.cost) + '</td></tr>';
+    });
+    rows += '<tr class="tt-total"><td>Total</td><td></td>' +
+      '<td class="num">' + esc(summary.total.time) + '</td>' +
+      '<td class="num">' + esc(summary.total.cost) + '</td></tr>';
+    var $p = $('<div id="tt-summary"><h4><i class="icon-time"></i> Time &amp; Cost</h4>' +
+      '<table><thead><tr><th>Logged on</th><th>Status</th><th class="num">Time</th>' +
+      '<th class="num">Cost</th></tr></thead><tbody>' + rows + '</tbody></table></div>');
+    var $tabs = $('ul#ticket_tabs');
+    if ($tabs.length) $p.insertBefore($tabs);
+  }
+
+  function decorateTasks() {
+    var $form = $('form#tasks[action="#tickets/' + cfg.ticketId + '/tasks"]');
+    if (!summary || !$form.length) return;
+    var $table = $form.find('table.list').first();
+    if (!$table.data('tt-cols')) {
+      $table.data('tt-cols', 1);
+      $table.find('thead tr').append('<th class="tt-col" width="70">Time</th><th class="tt-col" width="80">Cost</th>');
+    }
+    var byId = {};
+    $.each(summary.tasks, function(i, t) { byId[t.id] = t; });
+    $table.find('tbody.tasks > tr[id]').each(function() {
+      var t = byId[this.id], $c = $(this).children('td.tt-col');
+      if (!$c.length)
+        $c = $('<td class="tt-col"></td><td class="tt-col"></td>').appendTo(this);
+      $c.eq(0).text(t ? t.time : '');
+      $c.eq(1).text(t ? t.cost : '');
+    });
+  }
+
+  function refresh() {
+    if (!cfg.summaryUrl || loading) return;
+    loading = true;
+    $.ajax({url: cfg.summaryUrl, dataType: 'json', cache: false})
+      .done(function(data) { summary = data; renderPanel(); decorateTasks(); })
+      .always(function() { loading = false; });
+  }
+
+  function watchTasks() {
+    if (!window.MutationObserver || !cfg.ticketId) return;
+    if (window.__ttObserver) window.__ttObserver.disconnect();
+    var timer;
+    window.__ttObserver = new MutationObserver(function() {
+      clearTimeout(timer);
+      timer = setTimeout(function() {
+        // Left this ticket (PJAX navigation): stop watching
+        if (!$('form#reply input[name=id][value="' + cfg.ticketId + '"]').length &&
+            !$('form#note input[name=id][value="' + cfg.ticketId + '"]').length &&
+            !$('ul#ticket_tabs').length) {
+          window.__ttObserver.disconnect();
+          return;
+        }
+        var $t = $('form#tasks[action="#tickets/' + cfg.ticketId + '/tasks"] table.list').first();
+        if ($t.length && !$t.data('tt-cols')) refresh();   // tasks list (re)loaded
+      }, 150);
+    });
+    window.__ttObserver.observe(document.body, {childList: true, subtree: true});
+    // "All Tasks" just re-shows the cached list: refresh the numbers
+    $(document).off('click.ttsum').on('click.ttsum', '#all-ticket-tasks, a#ticket-tasks-tab', function() {
+      setTimeout(refresh, 50);
+    });
+  }
+
+  function init() {
+    if (cfg.scope === 'A') {
+      addTo('#task_reply', 'select[name="task:status"]', 'postreply');
+      addTo('#task_note', 'select[name="task:status"]', 'postnote');
+    } else {
+      addTo('#reply', 'select[name=reply_status_id]', 'reply');
+      addTo('#note', 'select[name=note_status_id]', 'postnote');
+    }
+    badges();
+    if (cfg.scope === 'T') { refresh(); watchTasks(); }
+  }
+
+  // Works for a normal page load, PJAX navigation and tasks loaded by AJAX
+  $(function() { setTimeout(init, 0); });
+})(jQuery);
+</script>
