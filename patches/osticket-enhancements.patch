+<?php
+require_once INCLUDE_DIR . 'class.plugin.php';
+require_once INCLUDE_DIR . 'class.forms.php';
+
+class TaskStatusConfig extends PluginConfig {
+
+    function getOptions() {
+        return array(
+            'statuses' => new TextareaField(array(
+                'label' => 'Task statuses',
+                'required' => true,
+                'default' => "Open | open\nIn Progress | open\nWaiting on Parts | open\nCompleted | closed\nInactive | closed",
+                'hint' => 'One per line: Name | open  or  Name | closed.
+                    "closed" statuses behave like a closed task (Closed tab,
+                    no longer counted as open). The first open status is used
+                    for new and reopened tasks; the first closed status is used
+                    when a task is closed without choosing one (Close button,
+                    bulk close). Tasks whose status is renamed or removed show
+                    the first status of the same state.',
+                'configuration' => array('rows' => 8, 'cols' => 40, 'html' => false),
+            )),
+        );
+    }
+
+    function pre_save(&$config, &$errors) {
+        $list = TaskStatusPlugin::parseList(@$config['statuses']);
+        $states = array_unique(array_values($list));
+        if (!in_array('open', $states) || !in_array('closed', $states))
+            $errors['err'] = 'Define at least one "open" and one "closed" status.';
+        return !$errors;
+    }
+}
