diff --git a/include/plugins/ticket-to-task/convert.php b/include/plugins/ticket-to-task/convert.php
new file mode 100644
index 0000000..646dc02
--- /dev/null
+++ b/include/plugins/ticket-to-task/convert.php
@@ -0,0 +1,340 @@
+<?php
+/*********************************************************************
+ * Convert Ticket to Task plugin for osTicket 1.17 / 1.18
+ *
+ * Adds "Convert to Task" to the staff ticket "More" menu. The dialog asks
+ * for the target ticket number, task title and department, and whether
+ * the original ticket is closed (with a chosen closed status) or deleted.
+ *
+ * Converting:
+ *   1. creates a task on the target ticket (assigned like the original),
+ *   2. copies every message / reply / note of the original thread into
+ *      the task with original author, date and attachments,
+ *   3. adds the original's customer and collaborators to the target ticket,
+ *   4. moves the original's own tasks to the target ticket,
+ *   5. moves Time & Cost entries (if that plugin is installed) to the task,
+ *   6. logs notes on both tickets, then closes or deletes the original.
+ *********************************************************************/
+
+require_once INCLUDE_DIR . 'class.plugin.php';
+require_once INCLUDE_DIR . 'class.signal.php';
+require_once __DIR__ . '/config.php';
+
+class TicketToTaskPlugin extends Plugin {
+    var $config_class = 'TicketToTaskConfig';
+
+    static $opts = null;
+
+    function isMultiInstance() {
+        return false;
+    }
+
+    function bootstrap() {
+        self::$opts = array(
+            'allow_delete' => (bool) $this->getConfig()->get('allow_delete', true),
+        );
+        Signal::connect('ticket.view.more', array(__CLASS__, 'onMoreMenu'), 'Ticket');
+        Signal::connect('ajax.scp', array(__CLASS__, 'onAjax'));
+    }
+
+    /* ---------------------------------------------------------------
+     * Menu + routes
+     * ------------------------------------------------------------- */
+
+    static function canConvert($ticket) {
+        global $thisstaff;
+        return $thisstaff && $ticket
+            && !$ticket->isChild() && !$ticket->isParent()
+            && ($ticket->checkStaffPerm($thisstaff, Ticket::PERM_CLOSE)
+                || (self::$opts['allow_delete']
+                    && $ticket->checkStaffPerm($thisstaff, Ticket::PERM_DELETE)));
+    }
+
+    static function onMoreMenu($ticket, &$extras=null) {
+        if (!self::canConvert($ticket))
+            return;
+        printf('<li><a href="#ajax.php/ticket2task/%d" onclick="javascript:
+                $.dialog($(this).attr(\'href\').substr(1), 201);
+                return false"><i class="icon-tasks"></i> %s</a></li>',
+            $ticket->getId(), Format::htmlchars(__('Convert to Task')));
+    }
+
+    static function onAjax($dispatcher) {
+        // Closures: the dispatcher would instantiate a class callback
+        $dispatcher->append(url_get('^/ticket2task/lookup$',
+            function() { TicketToTaskPlugin::ajaxLookup(); }));
+        $dispatcher->append(url('^/ticket2task/(?P<tid>\d+)$',
+            function($tid) { TicketToTaskPlugin::ajaxDialog($tid); }));
+    }
+
+    /** Target ticket preview: ?number=123456&from=<source id> */
+    static function ajaxLookup() {
+        global $thisstaff;
+        if (!$thisstaff)
+            Http::response(403, 'Login required');
+        $out = array('ok' => false);
+        $num = trim((string) @$_GET['number']);
+        if ($num !== '' && ($t = Ticket::lookupByNumber($num))) {
+            if ((int) $t->getId() === (int) @$_GET['from'])
+                $out['error'] = __('That is this ticket.');
+            elseif (!$t->checkStaffPerm($thisstaff, Task::PERM_CREATE))
+                $out['error'] = __('You cannot add tasks to that ticket.');
+            else
+                $out = array('ok' => true,
+                    'subject' => Format::truncate($t->getSubject(), 60),
+                    'dept_id' => $t->getDeptId(),
+                    'status' => $t->getStatus()->getName());
+        } elseif ($num !== '') {
+            $out['error'] = __('No ticket with that number.');
+        }
+        Http::response(200, JsonDataEncoder::encode($out), 'application/json');
+    }
+
+    static function ajaxDialog($tid) {
+        global $thisstaff;
+
+        if (!$thisstaff)
+            Http::response(403, 'Login required');
+        if (!($ticket = Ticket::lookup((int) $tid)) || !$ticket->checkStaffPerm($thisstaff))
+            Http::response(404, 'No such ticket');
+        if (!self::canConvert($ticket))
+            Http::response(403, 'Permission denied');
+
+        $canClose = $ticket->checkStaffPerm($thisstaff, Ticket::PERM_CLOSE);
+        $canDelete = self::$opts['allow_delete']
+            && $ticket->checkStaffPerm($thisstaff, Ticket::PERM_DELETE);
+        $closedStatuses = array();
+        foreach (TicketStatusList::getStatuses(array('states' => array('closed'))) as $s)
+            if ($s->isEnabled())
+                $closedStatuses[$s->getId()] = $s->getName();
+
+        $info = $errors = array();
+        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
+            $info = $_POST;
+            if ($task = self::convert($ticket, $_POST, $errors, $canClose, $canDelete,
+                    array_keys($closedStatuses))) {
+                // Plain-text JSON: the dialog code parses it and follows "redirect"
+                Http::response(200, JsonDataEncoder::encode(array(
+                    'redirect' => 'tasks.php?id=' . $task->getId())));
+            }
+        } else {
+            $info = array(
+                'title' => $ticket->getSubject(),
+                'original' => $canClose ? 'close' : 'delete',
+            );
+            // Default to a status literally called "Closed", else the first
+            foreach ($closedStatuses as $id => $name)
+                if (!isset($info['status_id']) || !strcasecmp($name, 'Closed'))
+                    $info['status_id'] = $id;
+        }
+        include __DIR__ . '/dialog.tmpl.php';
+    }
+
+    /* ---------------------------------------------------------------
+     * Conversion
+     * ------------------------------------------------------------- */
+
+    static function convert($source, $vars, &$errors, $canClose, $canDelete, $closedIds) {
+        global $thisstaff, $ost;
+
+        // ---- validate
+        $num = trim((string) @$vars['target']);
+        $target = $num !== '' ? Ticket::lookupByNumber($num) : null;
+        if (!$target)
+            $errors['target'] = __('Enter a valid ticket number.');
+        elseif ($target->getId() == $source->getId())
+            $errors['target'] = __('Choose a different ticket.');
+        elseif (!$target->checkStaffPerm($thisstaff, Task::PERM_CREATE))
+            $errors['target'] = __('You cannot add tasks to that ticket.');
+
+        $title = trim((string) @$vars['title']);
+        if ($title === '')
+            $errors['title'] = __('Title is required.');
+
+        $dept = (int) @$vars['dept_id'] ? Dept::lookup((int) $vars['dept_id'])
+            : ($target ? $target->getDept() : null);
+        if (!$dept && !isset($errors['target']))
+            $errors['dept_id'] = __('Department is required.');
+
+        $original = @$vars['original'];
+        if ($original === 'delete' && !$canDelete)
+            $errors['original'] = __('You cannot delete this ticket.');
+        elseif ($original === 'close' && !$canClose)
+            $errors['original'] = __('You cannot close this ticket.');
+        elseif (!in_array($original, array('close', 'delete')))
+            $errors['original'] = __('Choose what happens to this ticket.');
+        if ($original === 'close' && !in_array((int) @$vars['status_id'], $closedIds))
+            $errors['status_id'] = __('Choose a closed status.');
+
+        if ($errors) {
+            $errors['err'] = __('Correct the errors below and try again.');
+            return false;
+        }
+
+        $srcThread = $source->getThread();
+        $srcNumber = $source->getNumber();
+        $srcLink = sprintf('<a href="tickets.php?id=%d"><b>#%s</b></a>',
+            $source->getId(), $srcNumber);
+
+        // ---- 1. create the task
+        $assignee = $source->getStaff() ?: null;
+        $user = $source->getOwner();
+        $desc = sprintf('<p>%s</p><p>%s: %s<br>%s: %s<br>%s: %s</p>',
+            sprintf(__('Converted from ticket %s by %s.'),
+                $original === 'delete' ? '#' . $srcNumber : $srcLink,
+                Format::htmlchars($thisstaff->getName())),
+            __('Subject'), Format::htmlchars($source->getSubject()),
+            __('Customer'), Format::htmlchars($user ? sprintf('%s (%s)',
+                $user->getName(), $user->getEmail()) : ''),
+            __('Created'), Format::datetime($source->getCreateDate()));
+        $tvars = array(
+            'object_id' => $target->getId(),
+            'object_type' => ObjectModel::OBJECT_TYPE_TICKET,
+            'default_formdata' => array('title' => $title, 'description' => $desc),
+            'internal_formdata' => array('dept_id' => $dept->getId(),
+                'assignee' => $assignee),
+            'description' => $desc,
+            'staffId' => $thisstaff->getId(),
+            'poster' => $thisstaff,
+            'ip_address' => $_SERVER['REMOTE_ADDR'],
+        );
+        if (!($task = Task::create($tvars, $errors))) {
+            $errors['err'] = $errors['err'] ?: __('Unable to create the task.');
+            return false;
+        }
+
+        // ---- 2. copy the thread
+        $map = self::copyThread($srcThread->getId(), $task->getThread()->getId());
+
+        // ---- 3. customer + collaborators -> target ticket
+        $e = array();
+        $people = array();
+        if ($user)
+            $people[] = $user;
+        foreach ($source->getCollaborators() as $c)
+            if ($u = $c->getUser())
+                $people[] = $u;
+        foreach ($people as $u) {
+            if ($u->getId() == $target->getOwnerId())
+                continue;
+            $target->addCollaborator($u, array(), $e);
+        }
+
+        // ---- 4. move the original's tasks
+        foreach (Task::objects()->filter(array(
+                'object_id' => $source->getId(),
+                'object_type' => ObjectModel::OBJECT_TYPE_TICKET)) as $t) {
+            $t->object_id = $target->getId();
+            $t->save();
+        }
+
+        // ---- 5. Time & Cost entries
+        self::moveTimeEntries($source->getId(), $task->getId(), $target->getId(), $map);
+
+        // ---- 6. notes, then close / delete the original
+        $taskLink = sprintf('<a href="tasks.php?id=%d"><b>#%s</b></a>',
+            $task->getId(), $task->getNumber());
+        $targetLink = sprintf('<a href="tickets.php?id=%d"><b>#%s</b></a>',
+            $target->getId(), $target->getNumber());
+        $target->logNote(__('Task created from ticket'),
+            sprintf(__('Ticket %s (%s) was converted to task %s by %s.'),
+                $original === 'delete' ? '#' . $srcNumber : $srcLink,
+                Format::htmlchars($source->getSubject()), $taskLink,
+                Format::htmlchars($thisstaff->getName())),
+            $thisstaff, false);
+
+        if ($original === 'delete') {
+            $source->delete(sprintf(__('Converted to task #%s on ticket #%s'),
+                $task->getNumber(), $target->getNumber()));
+        } else {
+            $source->logNote(__('Converted to task'),
+                sprintf(__('This ticket was converted to task %s on ticket %s by %s.'),
+                    $taskLink, $targetLink, Format::htmlchars($thisstaff->getName())),
+                $thisstaff, false);
+            $e = array();
+            $status = TicketStatus::lookup((int) $vars['status_id']);
+            if (!$source->isClosed() || $source->getStatusId() != $status->getId())
+                $source->setStatus($status, '', $e, true, true);
+            if ($e)
+                $ost->logWarning('Convert Ticket to Task', sprintf(
+                    'Task #%s created, but ticket #%s could not be closed: %s',
+                    $task->getNumber(), $srcNumber, implode('; ', $e)), false);
+        }
+        return $task;
+    }
+
+    /**
+     * Copy all messages, replies and notes (not system events) from one
+     * thread to another, keeping author, dates and attachments.
+     * Returns array(old entry id => new entry id).
+     */
+    static function copyThread($fromThreadId, $toThreadId) {
+        $P = TABLE_PREFIX;
+        $map = array();
+        $cols = 'staff_id, user_id, type, poster, editor, editor_type, source,
+                 title, body, format, ip_address, extra, recipients, created, updated';
+        $res = db_query(sprintf(
+            "SELECT id, pid, flags FROM `{$P}thread_entry`
+             WHERE thread_id=%d AND type IN ('M','R','N') ORDER BY created, id",
+            $fromThreadId));
+        $rows = array();
+        while ($res && ($r = db_fetch_array($res)))
+            $rows[] = array_map('intval', $r);
+
+        foreach ($rows as $r) {
+            $old = $r['id'];
+            // Not the original message of the task (the task description is)
+            $newFlags = $r['flags'] & ~ThreadEntry::FLAG_ORIGINAL_MESSAGE;
+            if (!db_query(sprintf(
+                "INSERT INTO `{$P}thread_entry` (thread_id, pid, flags, $cols)
+                 SELECT %d, 0, %d, $cols FROM `{$P}thread_entry` WHERE id=%d",
+                $toThreadId, $newFlags, $old)))
+                continue;
+            $new = (int) db_insert_id();
+            $map[$old] = $new;
+
+            db_query(sprintf(
+                "INSERT INTO `{$P}attachment` (object_id, type, file_id, name, inline, lang)
+                 SELECT %d, type, file_id, name, inline, lang FROM `{$P}attachment`
+                 WHERE object_id=%d AND type='H'", $new, $old));
+            db_query(sprintf(
+                "INSERT IGNORE INTO `{$P}_search` (object_type, object_id, title, content)
+                 SELECT 'H', %d, title, content FROM `{$P}_search`
+                 WHERE object_type='H' AND object_id=%d", $new, $old));
+        }
+        // Keep reply-to links between copied entries
+        foreach ($rows as $r)
+            if ($r['pid'] && isset($map[$r['id']], $map[$r['pid']]))
+                db_query(sprintf("UPDATE `{$P}thread_entry` SET pid=%d WHERE id=%d",
+                    $map[$r['pid']], $map[$r['id']]));
+        return $map;
+    }
+
+    /** Re-attribute Time & Cost rows of the ticket to the new task. */
+    static function moveTimeEntries($srcTicketId, $taskId, $targetId, $map) {
+        if (!class_exists('TimeTrackingPlugin') || !TimeTrackingPlugin::$opts)
+            return;
+        if (!TimeTrackingPlugin::ensureSchema())
+            return;
+        $T = TimeTrackingPlugin::table();
+
+        // Keep any hand-entered value on the target ticket before rows arrive
+        TimeTrackingPlugin::seedOpening('T', $targetId, $targetId);
+
+        foreach ($map as $old => $new)
+            db_query(sprintf("UPDATE `%s` SET thread_entry_id=%d
+                WHERE object_type='T' AND object_id=%d AND thread_entry_id=%d",
+                $T, $new, $srcTicketId, $old));
+        // Hand-entered value on the original ticket becomes the task's opening row
+        TimeTrackingPlugin::seedOpening('T', $srcTicketId, $srcTicketId);
+        db_query(sprintf("UPDATE `%s` SET object_type='A', object_id=%d, ticket_id=%d
+            WHERE object_type='T' AND object_id=%d", $T, $taskId, $targetId, $srcTicketId));
+        // The original's existing tasks moved to the target ticket too
+        db_query(sprintf("UPDATE `%s` SET ticket_id=%d
+            WHERE object_type='A' AND ticket_id=%d", $T, $targetId, $srcTicketId));
+
+        TimeTrackingPlugin::updateTotals('A', $taskId);
+        TimeTrackingPlugin::updateTotals('T', $targetId);
+        TimeTrackingPlugin::updateTotals('T', $srcTicketId);
+    }
+}
